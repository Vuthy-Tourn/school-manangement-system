<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.TeachersPage"
             x:Name="TeachersRootPage"
             x:DataType="vm:TeachersViewModel"
             Title="Faculty &amp; Staff Directory"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">

        <!-- Search Bar and Action Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <!-- Search Box -->
                <SearchBar Grid.Column="0"
                           Text="{Binding SearchTerm}"
                           Placeholder="Search by faculty name, ID, or subject..."
                           PlaceholderColor="{StaticResource TextSubtle}"
                           TextColor="{StaticResource TextPrimary}"
                           SearchCommand="{Binding LoadTeachersCommand}"
                           BackgroundColor="Transparent"
                           FontSize="13"
                           HeightRequest="44"
                           VerticalOptions="Center" />

                <!-- Add Teacher Button -->
                <Button Grid.Column="1"
                        Text="+ Register Teacher"
                        Clicked="OnAddTeacherClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="44"
                        Padding="16,0" />
            </Grid>
        </VerticalStackLayout>

        <!-- Teachers Collection View -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTeachersCommand}">
            <CollectionView ItemsSource="{Binding Teachers}">
                <CollectionView.EmptyView>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,20"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_faculty.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                            <Label Text="No Faculty Found"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No teacher records match your query. Click '+ Register Teacher' to enroll a new faculty member."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="340" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TeacherDto">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.ViewTeacherDetailCommand, Source={x:Reference TeachersRootPage}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                                <!-- Top Section: Avatar, Teacher Info & Active Status Pill -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Start">

                                    <!-- Faculty Avatar -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 22"
                                            BackgroundColor="{StaticResource SecondaryLight}"
                                            Stroke="{StaticResource SecondaryBorder}"
                                            StrokeThickness="1"
                                            HeightRequest="44" WidthRequest="44"
                                            VerticalOptions="Start">
                                        <Image Source="icon_faculty.png"
                                               WidthRequest="22" HeightRequest="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Teacher Details -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <!-- Full Name -->
                                        <Label Text="{Binding FullName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />

                                        <!-- Specialization Badge: Displayed on its own line to prevent any overflow -->
                                        <Border StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Stroke="{StaticResource PrimaryBorder}"
                                                StrokeThickness="1"
                                                Padding="8,2"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding Specialization}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Border>

                                        <!-- Identification and Qualification -->
                                        <Label LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               FontSize="11">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding EmployeeNumber}" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" />
                                                    <Span Text=" • " TextColor="{StaticResource TextSubtle}" />
                                                    <Span Text="{Binding Qualification}" TextColor="{StaticResource TextSecondary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Status Pill in Top-Right Corner -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource SuccessLight}"
                                            Stroke="{StaticResource SuccessBorder}"
                                            StrokeThickness="1"
                                            Padding="10,3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start">
                                        <Label Text="Active"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SuccessText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="TextColor" Value="{StaticResource DangerText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <!-- Bottom Section: Email on left and Action Buttons on right -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0"
                                           Text="{Binding Email}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextMuted}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           VerticalOptions="Center" />

                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                                        <Button Text="Edit"
                                                Command="{Binding BindingContext.EditTeacherCommand, Source={x:Reference TeachersRootPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                TextColor="{StaticResource SecondaryDark}"
                                                BorderColor="{StaticResource SecondaryBorder}"
                                                BorderWidth="1"
                                                CornerRadius="6"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="30"
                                                Padding="14,0" />

                                        <Button Text="Deactivate"
                                                Command="{Binding BindingContext.DeactivateTeacherCommand, Source={x:Reference TeachersRootPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource DangerLight}"
                                                TextColor="{StaticResource DangerText}"
                                                BorderColor="{StaticResource DangerBorder}"
                                                BorderWidth="1"
                                                CornerRadius="6"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="30"
                                                Padding="14,0" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
