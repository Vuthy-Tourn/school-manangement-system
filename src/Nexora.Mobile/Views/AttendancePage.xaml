<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.AttendancePage"
             x:Name="AttendanceRootPage"
             x:DataType="vm:AttendanceViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid>
        <!-- 1. FACULTY / ADMIN VIEW -->
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="20,16,20,20"
              IsVisible="{Binding IsFacultyView}">

            <!-- Header Filter & Metrics Card -->
            <Border Grid.Row="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="18,16"
                    Margin="0,0,0,14">
                <VerticalStackLayout Spacing="14">

                    <!-- Teacher View (No Class Filter): Permitted Subject/Class & Date Picker -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowTeacherSubjectFilter}">
                        <!-- Teaching Subject & Class Selector -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Subject Session &amp; Class"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Picker ItemsSource="{Binding Sessions}"
                                        ItemDisplayBinding="{Binding PickerDisplayWithClass}"
                                        SelectedItem="{Binding SelectedSession}"
                                        Title="{Binding SessionPickerPlaceholder}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="12"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Attendance Date Picker -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Attendance Date"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <DatePicker Date="{Binding SelectedDate}"
                                            Format="yyyy-MM-dd"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="13"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Admin View: Class Selector & Date Picker Row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowClassFilter}">
                        <!-- Class Selector -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Academic Class"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Picker ItemsSource="{Binding Classes}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedClass}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date Picker -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Attendance Date"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <DatePicker Date="{Binding SelectedDate}"
                                            Format="yyyy-MM-dd"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="13"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Admin Only: Class Session / Timetable Period Selector -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowClassFilter}">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Class Session / Timetable Period"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Stroke="{StaticResource PrimaryBorder}"
                                    StrokeThickness="1"
                                    Padding="6,2"
                                    VerticalOptions="Center">
                                <Label Text="{Binding SelectedSessionTimeSlot}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="10,0"
                                HeightRequest="42">
                            <Picker ItemsSource="{Binding Sessions}"
                                    ItemDisplayBinding="{Binding PickerDisplay}"
                                    SelectedItem="{Binding SelectedSession}"
                                    Title="{Binding SessionPickerPlaceholder}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Advisory Authority & Permission Status Banner -->
                    <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="{Binding AdvisorRoleBadgeBg}"
                            Stroke="{Binding AdvisorRoleBadgeBorder}"
                            StrokeThickness="1"
                            Padding="14,10"
                            IsVisible="{Binding ShowAdvisorRoleBanner}">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{Binding AdvisorRolePillBg}"
                                        Stroke="{Binding AdvisorRoleBadgeBorder}"
                                        StrokeThickness="1"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding AdvisorRoleBadge}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding AdvisorRoleBadgeText}"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="2"
                                       Text="{Binding AdvisorRoleTag}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       TextColor="{Binding AdvisorRoleTagColor}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding AdvisorRoleSubtitle}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Attendance Rate & Quick Action Bar -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center"
                          IsVisible="{Binding HasClassesScheduled}">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SuccessLight}"
                                    Stroke="{StaticResource SuccessBorder}"
                                    StrokeThickness="1"
                                    Padding="8,3">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Present Rate:" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" />
                                    <Label Text="{Binding CurrentPresentRate, StringFormat='{0:F1}%'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Success}" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="Mark All Present"
                                Command="{Binding MarkAllPresentCommand}"
                                IsEnabled="{Binding CanTakeAttendanceActions}"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                TextColor="{StaticResource Secondary}"
                                BorderColor="{StaticResource SecondaryBorder}"
                                BorderWidth="1"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="34"
                                Padding="12,0"
                                CornerRadius="6" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Student Attendance Roster -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <Grid>
                    <!-- Class Roster (When classes are scheduled) -->
                    <CollectionView ItemsSource="{Binding StudentItems}"
                                    IsVisible="{Binding HasStudents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttendanceItemViewModel">
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceCard}"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    Padding="16,12"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- Student Info -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference AttendanceRootPage}, Path=BindingContext.EditRemarksCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding StudentName}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               FontSize="11">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding AdmissionNumber}" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" />
                                                    <Span Text=" • " TextColor="{StaticResource TextSubtle}" />
                                                    <Span Text="{Binding Status}" TextColor="{StaticResource TextSecondary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding RemarksDisplay}"
                                               FontSize="10.5"
                                               TextColor="{StaticResource SecondaryDark}"
                                               FontAttributes="Italic"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               IsVisible="{Binding HasRemarks}" />
                                    </VerticalStackLayout>

                                    <!-- Status Selection Chips -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <!-- Present -->
                                        <Button Text="P"
                                                Command="{Binding SetStatusCommand}"
                                                CommandParameter="Present"
                                                WidthRequest="32" HeightRequest="32"
                                                CornerRadius="6"
                                                FontSize="12" FontAttributes="Bold"
                                                BackgroundColor="{Binding PresentBgColor}"
                                                TextColor="{Binding PresentTextColor}"
                                                BorderColor="{Binding PresentBorderColor}"
                                                BorderWidth="1.5"
                                                Padding="0" />
                                        <!-- Late -->
                                        <Button Text="L"
                                                Command="{Binding SetStatusCommand}"
                                                CommandParameter="Late"
                                                WidthRequest="32" HeightRequest="32"
                                                CornerRadius="6"
                                                FontSize="12" FontAttributes="Bold"
                                                BackgroundColor="{Binding LateBgColor}"
                                                TextColor="{Binding LateTextColor}"
                                                BorderColor="{Binding LateBorderColor}"
                                                BorderWidth="1.5"
                                                Padding="0" />
                                        <!-- Absent -->
                                        <Button Text="A"
                                                Command="{Binding SetStatusCommand}"
                                                CommandParameter="Absent"
                                                WidthRequest="32" HeightRequest="32"
                                                CornerRadius="6"
                                                FontSize="12" FontAttributes="Bold"
                                                BackgroundColor="{Binding AbsentBgColor}"
                                                TextColor="{Binding AbsentTextColor}"
                                                BorderColor="{Binding AbsentBorderColor}"
                                                BorderWidth="1.5"
                                                Padding="0" />
                                        <!-- Excused (Permission) -->
                                        <Button Text="E"
                                                Command="{Binding SetStatusCommand}"
                                                CommandParameter="Excused"
                                                WidthRequest="32" HeightRequest="32"
                                                CornerRadius="6"
                                                FontSize="12" FontAttributes="Bold"
                                                BackgroundColor="{Binding ExcusedBgColor}"
                                                TextColor="{Binding ExcusedTextColor}"
                                                BorderColor="{Binding ExcusedBorderColor}"
                                                BorderWidth="1.5"
                                                Padding="0" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Explicit Empty State (Bypasses iOS UICollectionView EmptyView layout bug) -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource SurfaceCard}"
                        Stroke="{StaticResource SurfaceBorder}"
                        Padding="32"
                        Margin="0,20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding HasNoStudents}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="icon_attendance.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                        <Label Text="No Students Found"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="No enrolled students found for the selected academic class."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Dedicated "No Classes" State (When teacher has no class on this date) -->
                <ScrollView IsVisible="{Binding HasNoClassesScheduled}">
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            Padding="28,32"
                            Margin="0,8,0,16"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">

                            <!-- Visual Icon Container -->
                            <Border StrokeShape="RoundRectangle 40"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Stroke="{StaticResource PrimaryBorder}"
                                    StrokeThickness="1"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    HorizontalOptions="Center">
                                <Image Source="icon_timetable.png"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Title and Messages -->
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="{Binding NoClassesTitle}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="{Binding NoClassesMessage}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       MaximumWidthRequest="320" />
                            </VerticalStackLayout>

                            <!-- Info Pill Badge -->
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    Padding="14,6"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding SelectedDate, StringFormat='Schedule for {0:dddd, MMMM d, yyyy}'}"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>

                            <!-- Hint text -->
                            <Label Text="{Binding NoClassesSubtext}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource TextSubtle}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   Margin="0,4,0,0" />

                        </VerticalStackLayout>
                    </Border>
                </ScrollView>
            </Grid>
        </RefreshView>

        <!-- Save Button Footer -->
        <Border Grid.Row="2" BackgroundColor="Transparent" Padding="0,12,0,0"
                IsVisible="{Binding HasClassesScheduled}">
            <Button Text="{Binding SaveButtonText}"
                    Command="{Binding SaveAttendanceCommand}"
                    IsEnabled="{Binding CanTakeAttendanceActions}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="8" />
        </Border>
        </Grid>        <!-- 2. STUDENT & PARENT ATTENDANCE VIEW -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsStudentView}">
            <ScrollView>
                <VerticalStackLayout Spacing="18" Padding="20,16,20,30">

                    <!-- Parent Children Switcher (shown only if parent has multiple children) -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="16,14"
                            IsVisible="{Binding HasMultipleChildren}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="Select Child"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Button Text="Ask Permission"
                                        Command="{Binding OpenPermissionModalCommand}"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        TextColor="{StaticResource Primary}"
                                        BorderColor="{StaticResource PrimaryBorder}"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        CornerRadius="6"
                                        VerticalOptions="Center" />
                            </Grid>

                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Picker ItemsSource="{Binding ParentChildren}"
                                        ItemDisplayBinding="{Binding FullName}"
                                        SelectedItem="{Binding SelectedParentChild}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Summary Metrics (Rate, Present, Excused, Late) at the top -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <!-- Present Rate -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Rate" FontSize="10" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding CurrentPresentRate, StringFormat='{0:F1}%'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Present Days -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Present" FontSize="10" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding ChildPresentDays}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Excused Days -->
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Excused" FontSize="10" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding ChildExcusedDays}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Late Days -->
                        <Border Grid.Column="3"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Late" FontSize="10" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding ChildLateDays}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{StaticResource WarningText}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Parent Action Bar (shown when parent has 1 child) -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" IsVisible="{Binding HasSingleChild}">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Child Attendance Overview"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding SelectedParentChild.FullName}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Ask Permission"
                                Command="{Binding OpenPermissionModalCommand}"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource PrimaryBorder}"
                                BorderWidth="1"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="6"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Session-by-Session Period Attendance Card -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="18,16">
                        <VerticalStackLayout Spacing="14">
                            <!-- Header & Date Row -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Class Sessions &amp; Period Attendance"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding SelectedInspectionDateDisplay}"
                                           FontSize="11.5"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>

                                <!-- Overall Status Pill for the Day -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{Binding SelectedDayOverallStatusBgColor}"
                                        Stroke="{Binding SelectedDayOverallStatusBorderColor}"
                                        StrokeThickness="1"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding SelectedDayOverallStatusText}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding SelectedDayOverallStatusColor}"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Day Navigation & Date Filter Bar: Organized Two-Row Spacious Layout -->
                            <VerticalStackLayout Spacing="8">
                                <!-- Row 1: Broad Date Card with Calendar Picker and Today Button -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <!-- Date Selector Card (Spacious with full date display) -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource SurfaceCard}"
                                            Stroke="{StaticResource SurfaceBorder}"
                                            StrokeThickness="1"
                                            Padding="12,0"
                                            HeightRequest="42"
                                            VerticalOptions="Center">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <Image Grid.Column="0"
                                                   Source="icon_timetable.png"
                                                   WidthRequest="18"
                                                   HeightRequest="18"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SelectedInspectionDateDisplayShort}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                            <Path Grid.Column="2"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource TextMuted}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  VerticalOptions="Center"
                                                  HorizontalOptions="Center" />

                                            <!-- Overlay transparent DatePicker that catches the tap -->
                                            <DatePicker Grid.ColumnSpan="3"
                                                        Date="{Binding SelectedInspectionDate}"
                                                        MaximumDate="{Binding MaxInspectionDate}"
                                                        Opacity="0.015"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill" />
                                        </Grid>
                                    </Border>

                                    <!-- Jump to Today Button -->
                                    <Button Grid.Column="1"
                                            Text="Today"
                                            Command="{Binding InspectTodaySessionsCommand}"
                                            BackgroundColor="{Binding TodayButtonBgColor}"
                                            TextColor="{Binding TodayButtonTextColor}"
                                            BorderColor="{Binding TodayButtonBorderColor}"
                                            BorderWidth="1"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HeightRequest="42"
                                            Padding="16,0"
                                            CornerRadius="10"
                                            VerticalOptions="Center" />
                                </Grid>

                                <!-- Row 2: Navigation Prev Day / Next Day Bar -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Button Grid.Column="0"
                                            Text="&lt; Previous Day"
                                            Command="{Binding InspectPreviousDaySessionsCommand}"
                                            BackgroundColor="{StaticResource SurfaceCard}"
                                            TextColor="{StaticResource TextPrimary}"
                                            BorderColor="{StaticResource SurfaceBorder}"
                                            BorderWidth="1"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HeightRequest="38"
                                            CornerRadius="8"
                                            VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="Next Day &gt;"
                                            Command="{Binding InspectNextDaySessionsCommand}"
                                            IsEnabled="{Binding CanGoToNextInspectionDay}"
                                            BackgroundColor="{StaticResource SurfaceCard}"
                                            TextColor="{StaticResource TextPrimary}"
                                            BorderColor="{StaticResource SurfaceBorder}"
                                            BorderWidth="1"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HeightRequest="38"
                                            CornerRadius="8"
                                            VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Sessions List -->
                            <VerticalStackLayout Spacing="8">
                                <CollectionView ItemsSource="{Binding DaySessions}" SelectionMode="None">
                                    <CollectionView.EmptyView>
                                        <VerticalStackLayout Spacing="6" Padding="0,16" HorizontalOptions="Center">
                                            <Label Text="No scheduled class sessions found for this day."
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StudentSessionAttendanceItem">
                                            <Border StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{StaticResource SurfaceLight}"
                                                    Stroke="{StaticResource SurfaceBorder}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Period / Time Badge -->
                                                    <Border Grid.Column="0"
                                                            StrokeShape="RoundRectangle 6"
                                                            BackgroundColor="{StaticResource SurfaceCard}"
                                                            Stroke="{StaticResource SurfaceBorder}"
                                                            StrokeThickness="1"
                                                            Padding="6,6"
                                                            WidthRequest="76"
                                                            VerticalOptions="Center">
                                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                                            <Label Text="{Binding PeriodName}"
                                                                   FontSize="10"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource Primary}"
                                                                   HorizontalOptions="Center" />
                                                            <Label Text="{Binding TimeSlot}"
                                                                   FontSize="9.5"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   HorizontalOptions="Center" />
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <!-- Subject & Teacher Info -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding SubjectName}"
                                                               FontSize="12.5"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding SubtitleDisplay}"
                                                               FontSize="10.5"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Remarks}"
                                                               FontSize="10"
                                                               TextColor="{Binding StatusColor}"
                                                               FontAttributes="Italic"
                                                               IsVisible="{Binding HasRemarks}"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>

                                                    <!-- Status Badge Pill (no shortcut letter like P, L; just Present, Late, Excused, Absent) -->
                                                    <Border Grid.Column="2"
                                                            StrokeShape="RoundRectangle 6"
                                                            BackgroundColor="{Binding StatusBgColor}"
                                                            Stroke="{Binding StatusBorderColor}"
                                                            StrokeThickness="1"
                                                            Padding="8,5"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding StatusBadgeText}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding StatusColor}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Daily Attendance Records Section (Parents only) -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="18,16"
                            IsVisible="{Binding IsParentView}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="Daily Attendance Records"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding StudentFullName}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Interactive Attendance Filter Pills Bar -->
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,4">
                                <HorizontalStackLayout Spacing="6">
                                    <Button Text="{Binding FilterAllText}"
                                            Command="{Binding FilterAttendanceCommand}"
                                            CommandParameter="All"
                                            BackgroundColor="{Binding FilterAllBgColor}"
                                            TextColor="{Binding FilterAllTextColor}"
                                            FontSize="11" FontAttributes="Bold"
                                            HeightRequest="32" Padding="12,0"
                                            CornerRadius="16" />

                                    <Button Text="{Binding FilterPresentText}"
                                            Command="{Binding FilterAttendanceCommand}"
                                            CommandParameter="Present"
                                            BackgroundColor="{Binding FilterPresentBgColor}"
                                            TextColor="{Binding FilterPresentTextColor}"
                                            FontSize="11" FontAttributes="Bold"
                                            HeightRequest="32" Padding="12,0"
                                            CornerRadius="16" />

                                    <Button Text="{Binding FilterLateText}"
                                            Command="{Binding FilterAttendanceCommand}"
                                            CommandParameter="Late"
                                            BackgroundColor="{Binding FilterLateBgColor}"
                                            TextColor="{Binding FilterLateTextColor}"
                                            FontSize="11" FontAttributes="Bold"
                                            HeightRequest="32" Padding="12,0"
                                            CornerRadius="16" />

                                    <Button Text="{Binding FilterExcusedText}"
                                            Command="{Binding FilterAttendanceCommand}"
                                            CommandParameter="Excused"
                                            BackgroundColor="{Binding FilterExcusedBgColor}"
                                            TextColor="{Binding FilterExcusedTextColor}"
                                            FontSize="11" FontAttributes="Bold"
                                            HeightRequest="32" Padding="12,0"
                                            CornerRadius="16" />

                                    <Button Text="{Binding FilterAbsentText}"
                                            Command="{Binding FilterAttendanceCommand}"
                                            CommandParameter="Absent"
                                            BackgroundColor="{Binding FilterAbsentBgColor}"
                                            TextColor="{Binding FilterAbsentTextColor}"
                                            FontSize="11" FontAttributes="Bold"
                                            HeightRequest="32" Padding="12,0"
                                            CornerRadius="16" />
                                </HorizontalStackLayout>
                            </ScrollView>

                            <CollectionView ItemsSource="{Binding PagedChildAttendanceHistory}" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Spacing="6" Padding="0,20" HorizontalOptions="Center">
                                        <Image Source="icon_attendance.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" Opacity="0.5" />
                                        <Label Text="No attendance records found matching this filter."
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttendanceRecordDisplayItem">
                                        <Border StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{StaticResource SurfaceLight}"
                                                Stroke="{StaticResource SurfaceBorder}"
                                                Padding="14,12"
                                                Margin="0,0,0,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.InspectRecordSessionsCommand, Source={x:Reference AttendanceRootPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Label Text="{Binding FormattedDate}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}" />
                                                        <Label Text="•" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                                        <Label Text="{Binding CheckInTimeText}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource TextMuted}" />
                                                    </HorizontalStackLayout>

                                                    <Label Text="{Binding StatusDetailedText}"
                                                           FontSize="11"
                                                           TextColor="{Binding StatusColor}"
                                                           FontAttributes="Bold" />

                                                    <Label Text="{Binding Remarks}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource SecondaryDark}"
                                                           FontAttributes="Italic"
                                                           IsVisible="{Binding HasRemarks}"
                                                           LineBreakMode="WordWrap" />

                                                    <Label Text="Tap to inspect daily session periods"
                                                           FontSize="9.5"
                                                           TextColor="{StaticResource Primary}"
                                                           Margin="0,2,0,0" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{Binding StatusBgColor}"
                                                        Stroke="{Binding StatusBorderColor}"
                                                        StrokeThickness="1"
                                                        Padding="10,6"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding StatusBadgeText}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusColor}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Parent History Pagination Controls -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,10,0,0" VerticalOptions="Center" IsVisible="{Binding HasHistoryRecords}">
                                <Button Grid.Column="0"
                                        Text="&lt; Previous"
                                        Command="{Binding PreviousHistoryPageCommand}"
                                        IsEnabled="{Binding CanGoToPreviousHistoryPage}"
                                        BackgroundColor="{StaticResource SurfaceLight}"
                                        TextColor="{StaticResource TextPrimary}"
                                        BorderColor="{StaticResource SurfaceBorder}"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        CornerRadius="6"
                                        VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding HistoryPageInfo}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="Next &gt;"
                                        Command="{Binding NextHistoryPageCommand}"
                                        IsEnabled="{Binding CanGoToNextHistoryPage}"
                                        BackgroundColor="{StaticResource SurfaceLight}"
                                        TextColor="{StaticResource TextPrimary}"
                                        BorderColor="{StaticResource SurfaceBorder}"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        CornerRadius="6"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- 3. Backdrop Overlay for Ask Permission Modal (Reusable for Parents & Students) -->
        <Grid BackgroundColor="#99000000"
              IsVisible="{Binding IsPermissionModalVisible}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False"
              Padding="24"
              ZIndex="99">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePermissionModalCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    Padding="22"
                    VerticalOptions="Center"
                    MaximumWidthRequest="440"
                    HorizontalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DoNothingCommand}" />
                </Border.GestureRecognizers>
                <ScrollView MaximumHeightRequest="560">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding PermissionModalTitle}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Submit an excused absence notice to school"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="X"
                                    Command="{Binding ClosePermissionModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextMuted}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorder}" />

                        <!-- Child Selector (shown only if parent has multiple children) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasMultipleChildren}">
                            <Label Text="Select Child *"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Picker ItemsSource="{Binding ParentChildren}"
                                        ItemDisplayBinding="{Binding FullName}"
                                        SelectedItem="{Binding PermissionTargetChild}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date of Absence -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date of Absence / Leave *"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <DatePicker Date="{Binding PermissionDate}"
                                            Format="yyyy-MM-dd"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="13"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Reason Category -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Reason for Absence *"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Picker ItemsSource="{Binding PermissionReasons}"
                                        SelectedItem="{Binding SelectedPermissionReason}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Remarks -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Remarks / Doctor's Note (Optional)"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="10,8"
                                    HeightRequest="80">
                                <Editor Text="{Binding PermissionRemarks}"
                                        Placeholder="e.g., Doctor advised 1 day bed rest for mild fever..."
                                        PlaceholderColor="{StaticResource TextMuted}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="12"
                                        AutoSize="Disabled" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Actions -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Grid.Column="0"
                                    Text="Cancel"
                                    Command="{Binding ClosePermissionModalCommand}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    TextColor="{StaticResource TextSecondary}"
                                    BorderColor="{StaticResource SurfaceBorder}"
                                    BorderWidth="1"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="8" />

                            <Button Grid.Column="1"
                                    Text="Submit Permission"
                                    Command="{Binding SubmitPermissionCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    Padding="4,0"
                                    CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
