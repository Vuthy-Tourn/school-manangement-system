<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.TimetablesPage"
             x:DataType="vm:TimetablesViewModel"
             Title="Class Timetable"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">

        <!-- Weekday Segmented Selector Chips -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,16">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Monday"
                        Command="{Binding SelectDayCommand}"
                        CommandParameter="Monday"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        TextColor="{StaticResource Secondary}"
                        BorderColor="{StaticResource SecondaryBorder}"
                        BorderWidth="1" />
                <Button Text="Tuesday"
                        Command="{Binding SelectDayCommand}"
                        CommandParameter="Tuesday"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        TextColor="{StaticResource Secondary}"
                        BorderColor="{StaticResource SecondaryBorder}"
                        BorderWidth="1" />
                <Button Text="Wednesday"
                        Command="{Binding SelectDayCommand}"
                        CommandParameter="Wednesday"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        TextColor="{StaticResource Secondary}"
                        BorderColor="{StaticResource SecondaryBorder}"
                        BorderWidth="1" />
                <Button Text="Thursday"
                        Command="{Binding SelectDayCommand}"
                        CommandParameter="Thursday"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        TextColor="{StaticResource Secondary}"
                        BorderColor="{StaticResource SecondaryBorder}"
                        BorderWidth="1" />
                <Button Text="Friday"
                        Command="{Binding SelectDayCommand}"
                        CommandParameter="Friday"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        TextColor="{StaticResource Secondary}"
                        BorderColor="{StaticResource SecondaryBorder}"
                        BorderWidth="1" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Time Slots Schedule List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTimetableCommand}">
            <CollectionView ItemsSource="{Binding ScheduleSlots}">
                <CollectionView.EmptyView>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,20"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_timetable.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                            <Label Text="No Classes Scheduled"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No scheduled academic slots for this day."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TimetableEntryDto">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">

                                <!-- Time Slot Badge -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        Stroke="{StaticResource SecondaryBorder}"
                                        StrokeThickness="1"
                                        Padding="10,8"
                                        VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SecondaryDark}"
                                               HorizontalOptions="Center" />
                                        <Label Text="to"
                                               FontSize="9"
                                               TextColor="{StaticResource TextMuted}"
                                               HorizontalOptions="Center" />
                                        <Label Text="{Binding EndTime, StringFormat='{0:hh\\:mm}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SecondaryDark}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Academic Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding SubjectName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />

                                        <!-- Subject Code Badge -->
                                        <Border StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Stroke="{StaticResource PrimaryBorder}"
                                                StrokeThickness="1"
                                                Padding="6,1"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SubjectCode}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Teacher & Room -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding TeacherName, StringFormat='Teacher: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="•" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                        <Label Text="{Binding RoomNumber}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
