<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.TimetablesPage"
             x:Name="TimetablesRootPage"
             x:DataType="vm:TimetablesViewModel"
             Title="Class Timetable"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid BackgroundColor="{StaticResource SurfaceLight}">
        <!-- Main Timetable Content Layout -->
        <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">

        <!-- Class Section & Day Selection Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <!-- Class Selector & Enrolled Class Header -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding PageHeaderTitle}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{Binding PageHeaderSubtitle}"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Right Controls: Class Dropdown, Admin Assign Button, Enrolled Class Badge -->
                <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                    <!-- Class Dropdown (Faculty/Admin only) -->
                    <Border StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="12,0"
                            HeightRequest="36"
                            WidthRequest="130"
                            MinimumWidthRequest="120"
                            VerticalOptions="Center"
                            IsVisible="{Binding CanSwitchClass}">
                        <Picker ItemsSource="{Binding Classes}"
                                ItemDisplayBinding="{Binding Name, StringFormat='Class {0}'}"
                                SelectedItem="{Binding SelectedClass}"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                FontSize="12"
                                VerticalOptions="Center" />
                    </Border>

                    <!-- Assign Slot Button (Admin only) -->
                    <Button Text="+ Assign Slot"
                            Command="{Binding OpenAddSlotModalCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="36"
                            CornerRadius="8"
                            Padding="12,0"
                            VerticalOptions="Center"
                            IsVisible="{Binding CanManageTimetable}" />

                    <!-- Enrolled Class Section Badge (Student / Parent view - single class locked) -->
                    <Border StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Stroke="{StaticResource PrimaryBorder}"
                            Padding="14,0"
                            HeightRequest="36"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsStudentOrParent}">
                        <Label Text="{Binding EnrolledClassBadgeText}"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Weekday Segmented Selector Chips -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayChipViewModel">
                            <Border StrokeShape="RoundRectangle 8"
                                    HeightRequest="36"
                                    Padding="16,0"
                                    StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectDayCommand, Source={x:Reference TimetablesRootPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       InputTransparent="True"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource SecondaryDark}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryLight}" />
                                        <Setter Property="Stroke" Value="{StaticResource SecondaryBorder}" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <!-- Teacher Schedule Filter Segment (All Classes vs My Teaching Only) -->
            <Border StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="4"
                    IsVisible="{Binding IsTeacherUser}">
                <Grid ColumnDefinitions="*,*">
                    <!-- All Classes Filter Tab -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 6"
                            HeightRequest="34"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SetScheduleFilterCommand, Source={x:Reference TimetablesRootPage}}"
                                                  CommandParameter="All" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowOnlyMyTeaching}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowOnlyMyTeaching}" Value="True">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="All Classes (Show All)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowOnlyMyTeaching}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowOnlyMyTeaching}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- My Teaching Only Filter Tab -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 6"
                            HeightRequest="34"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SetScheduleFilterCommand, Source={x:Reference TimetablesRootPage}}"
                                                  CommandParameter="MyClasses" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowOnlyMyTeaching}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowOnlyMyTeaching}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="My Teaching Only"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowOnlyMyTeaching}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowOnlyMyTeaching}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Time Slots Schedule List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTimetableCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="0,0,0,24">

                    <!-- Empty State Card -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,16"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasNoSlots}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_timetable.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                            <Label Text="No Classes Scheduled"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No scheduled academic slots for this day."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Slots List via BindableLayout -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScheduleSlots}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimetableSlotItemViewModel">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{Binding CardBackgroundColor}"
                                        Stroke="{Binding CardBorderColor}"
                                        StrokeThickness="{Binding CardBorderThickness}"
                                        Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                        <!-- Time Slot Badge -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                Stroke="{StaticResource SecondaryBorder}"
                                                StrokeThickness="1"
                                                Padding="10,8"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                                <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource SecondaryDark}"
                                                        HorizontalOptions="Center" />
                                                <Label Text="to"
                                                        FontSize="9"
                                                        TextColor="{StaticResource TextMuted}"
                                                        HorizontalOptions="Center" />
                                                <Label Text="{Binding EndTime, StringFormat='{0:hh\\:mm}'}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource SecondaryDark}"
                                                        HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Academic Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding SubjectName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <!-- Subject Code Badge -->
                                                <Border StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="{StaticResource PrimaryLight}"
                                                        Stroke="{StaticResource PrimaryBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,1"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding SubjectCode}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}" />
                                                </Border>

                                                <!-- My Teaching Class Badge -->
                                                <Border StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="{StaticResource PrimaryLight}"
                                                        Stroke="{StaticResource PrimaryBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,1"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding ShowMyClassBadge}">
                                                    <Label Text="{Binding TeachingBadgeText}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Teacher & Room -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding TeacherName, StringFormat='Teacher: {0}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}" />
                                                <Label Text="•" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                                <Label Text="{Binding RoomNumber}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Remove Slot Button (Admin only) -->
                                        <Border Grid.Column="2"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#FEE2E2"
                                                Stroke="#FCA5A5"
                                                StrokeThickness="1"
                                                Padding="8,6"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding BindingContext.CanManageTimetable, Source={x:Reference TimetablesRootPage}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.DeleteSlotCommand, Source={x:Reference TimetablesRootPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Remove"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#DC2626"
                                                   InputTransparent="True"
                                                   VerticalOptions="Center" />
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        </Grid>

        <!-- Full-Screen Backdrop Overlay for Admin Assign Timetable Slot Modal -->
        <Grid BackgroundColor="#99000000"
              IsVisible="{Binding IsAddSlotModalVisible}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False"
              Padding="24">
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    Padding="20"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center">
                <ScrollView MaximumHeightRequest="540">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Assign Timetable Slot"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Schedule a subject and assign to teacher"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="X"
                                    Command="{Binding CloseAddSlotModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextSecondary}"
                                    FontSize="16"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0" />
                        </Grid>

                        <!-- Academic Class & Schedule Day Row -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Academic Class" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                    <Picker ItemsSource="{Binding Classes}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding ModalSelectedClass}"
                                            Title="Class"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="12"
                                            VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Schedule Day" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                    <Picker ItemsSource="{Binding Days}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding ModalSelectedDayChip}"
                                            Title="Day"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="12"
                                            VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Subject Picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Subject" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                <Picker ItemsSource="{Binding AvailableSubjects}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding NewSubject}"
                                        Title="Select Subject"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="12"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Teacher Picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Assign Teacher" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                <Picker ItemsSource="{Binding AvailableTeachers}"
                                        ItemDisplayBinding="{Binding FullName}"
                                        SelectedItem="{Binding NewTeacher}"
                                        Title="Select Teacher"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="12"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Start Time and End Time -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Start Time" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                    <TimePicker Time="{Binding NewStartTime}" TextColor="{StaticResource TextPrimary}" FontSize="12" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="End Time" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="8,0" HeightRequest="38">
                                    <TimePicker Time="{Binding NewEndTime}" TextColor="{StaticResource TextPrimary}" FontSize="12" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Room Number -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Room / Facility" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource SurfaceBorder}" BackgroundColor="{StaticResource SurfaceLight}" Padding="10,0" HeightRequest="38">
                                <Entry Text="{Binding NewRoomNumber}" Placeholder="e.g. Room 201, Physics Lab" TextColor="{StaticResource TextPrimary}" FontSize="12" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Grid.Column="0"
                                    Text="Cancel"
                                    Command="{Binding CloseAddSlotModalCommand}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    TextColor="{StaticResource TextSecondary}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="40"
                                    CornerRadius="8" />
                            <Button Grid.Column="1"
                                    Text="Assign Slot"
                                    Command="{Binding SaveTimetableSlotCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="40"
                                    CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
