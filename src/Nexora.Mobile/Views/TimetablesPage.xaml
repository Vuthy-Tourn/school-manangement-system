<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.TimetablesPage"
             x:DataType="vm:TimetablesViewModel"
             Title="Class Timetable"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">

        <!-- Class Section & Day Selection Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <!-- Class Selector -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Weekly Class Timetable"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Select class and academic day to view class hours"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource SurfaceCard}"
                        Stroke="{StaticResource SurfaceBorder}"
                        Padding="12,0"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Picker ItemsSource="{Binding Classes}"
                            ItemDisplayBinding="{Binding Name, StringFormat='Class {0}'}"
                            SelectedItem="{Binding SelectedClass}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            FontSize="12"
                            VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Weekday Segmented Selector Chips -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayChipViewModel">
                            <Button Text="{Binding Name}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimetablesViewModel}}, Path=SelectDayCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="14,0"
                                    FontSize="12"
                                    FontAttributes="Bold">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                        <Setter Property="BorderWidth" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryLight}" />
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryDark}" />
                                        <Setter Property="BorderColor" Value="{StaticResource SecondaryBorder}" />
                                        <Setter Property="BorderWidth" Value="1" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Time Slots Schedule List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTimetableCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="0,0,0,24">

                    <!-- Empty State Card -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,16"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasNoSlots}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_timetable.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                            <Label Text="No Classes Scheduled"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No scheduled academic slots for this day."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Slots List via BindableLayout -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScheduleSlots}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:TimetableEntryDto">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        StrokeThickness="1"
                                        Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">

                                        <!-- Time Slot Badge -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                Stroke="{StaticResource SecondaryBorder}"
                                                StrokeThickness="1"
                                                Padding="10,8"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                                <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource SecondaryDark}"
                                                       HorizontalOptions="Center" />
                                                <Label Text="to"
                                                       FontSize="9"
                                                       TextColor="{StaticResource TextMuted}"
                                                       HorizontalOptions="Center" />
                                                <Label Text="{Binding EndTime, StringFormat='{0:hh\\:mm}'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource SecondaryDark}"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Academic Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding SubjectName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <!-- Subject Code Badge -->
                                                <Border StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="{StaticResource PrimaryLight}"
                                                        Stroke="{StaticResource PrimaryBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,1"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding SubjectCode}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Teacher & Room -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding TeacherName, StringFormat='Teacher: {0}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}" />
                                                <Label Text="•" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                                <Label Text="{Binding RoomNumber}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
