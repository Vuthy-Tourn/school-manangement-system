<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.GradesPage"
             x:Name="GradesRootPage"
             x:DataType="vm:GradesViewModel"
             Title="{Binding PortalTitle}"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16">

        <!-- 1. Header & Filter Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,10">

            <!-- Exam & Class Selection Dropdowns -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="14,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Exam Picker -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Examination"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="8,0"
                                    HeightRequest="38">
                                <Picker ItemsSource="{Binding Exams}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedExam}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Class Picker (Faculty/Admin) -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding CanEditGrades}">
                            <Label Text="Class Section"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="8,0"
                                    HeightRequest="38">
                                <Picker ItemsSource="{Binding Classes}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedClass}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Student Badge (Student only view) -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsStudentOnlyView}">
                            <Label Text="Student Academic Record"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource PrimaryBorder}"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Padding="10,0"
                                    HeightRequest="38">
                                <Label Text="{Binding StudentDisplayName}"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Single Child Badge (Parent view with 1 child) -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsSingleChildParent}">
                            <Label Text="Student Academic Record"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource PrimaryBorder}"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Padding="10,0"
                                    HeightRequest="38">
                                <Label Text="{Binding StudentDisplayName}"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Child Selector Picker (Parent view with multiple children) -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding HasMultipleChildren}">
                            <Label Text="Viewing Child"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="8,0"
                                    HeightRequest="38">
                                <Picker ItemsSource="{Binding ParentChildren}"
                                        ItemDisplayBinding="{Binding FullName}"
                                        SelectedItem="{Binding SelectedChild}"
                                        Title="Select Child"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Student Filter Dropdown & Quick Search -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanEditGrades}">
                        <!-- Student Dropdown Picker -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Student Filter"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="8,0"
                                    HeightRequest="38">
                                <Picker ItemsSource="{Binding StudentOptions}"
                                        ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedStudentFilter}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="11"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Quick Search Text Entry -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Quick Search"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="8,0"
                                    HeightRequest="38">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                    <Image Source="icon_students.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" Opacity="0.6" />
                                    <Entry Grid.Column="1"
                                           Placeholder="Search name or ID..."
                                           Text="{Binding SearchText}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextPrimary}"
                                           PlaceholderColor="{StaticResource TextMuted}"
                                           ClearButtonVisibility="WhileEditing"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Student / Parent Academic Performance & Total Grade Card -->
            <Border IsVisible="{Binding IsStudentView}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="16,14">
                <VerticalStackLayout Spacing="12">
                    <!-- Top Row: Academic Summary Title, Standing, & Grade Badge -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="ACADEMIC SUMMARY"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="0.8" />
                                <Label Text="•" TextColor="{StaticResource TextMuted}" FontSize="10" />
                                <Label Text="{Binding TotalSubjectsCountText}"
                                       FontSize="10"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AcademicStandingText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <!-- Overall Letter Grade Badge -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{Binding OverallGradeBadgeBg}"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Grade" FontSize="11" FontAttributes="Bold" TextColor="{Binding OverallGradeBadgeColor}" VerticalOptions="Center" />
                                <Label Text="{Binding OverallGradeLetter}" FontSize="16" FontAttributes="Bold" TextColor="{Binding OverallGradeBadgeColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorder}" />

                    <!-- 4 Metric Pillars: Total Score | Average | GPA (4.0) | Class Rank -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <!-- Total Score -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="6,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Total Score" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding TotalScoreText}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Average Score -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="6,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Average" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding OverallPercentageText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Cumulative GPA -->
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="6,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="GPA (4.0)" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding CumulativeGpaText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Class Rank -->
                        <Border Grid.Column="3"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="6,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Standing" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                <Label Text="{Binding ClassRank, StringFormat='#{0}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource WarningText}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Horizontal Subject Chip Selector -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SubjectChips}" Spacing="6" Padding="0,2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubjectChipViewModel">
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    BackgroundColor="{Binding ChipBackground}"
                                    Stroke="{Binding ChipBorderColor}"
                                    HeightRequest="34"
                                    Padding="14,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectSubjectChipCommand, Source={x:Reference GradesRootPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding DisplayTitle}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding ChipTextColor}"
                                       InputTransparent="True"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

        </VerticalStackLayout>

        <!-- 2. Student Grading Roster List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding FilteredGrades}">
                <CollectionView.EmptyView>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="28"
                            Margin="0,16"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_grades.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" Opacity="0.5" />
                            <Label Text="No Matching Students Found"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No students match the current subject or search filter."
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GradeEntryItemViewModel">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <!-- Avatar / Initials Pill -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 18"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        Stroke="{StaticResource SecondaryBorder}"
                                        StrokeThickness="1"
                                        HeightRequest="36" WidthRequest="36"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding StudentInitials}"
                                           TextColor="{StaticResource SecondaryDark}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Subject / Student Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayTitle}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                    <Label Text="{Binding DisplaySubtitle}"
                                           FontSize="11"
                                           TextColor="{StaticResource SecondaryDark}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <!-- Live Grade Letter Badge -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{Binding GradeBadgeBg}"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding GradeLetter}"
                                           TextColor="{Binding GradeBadgeColor}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           HorizontalOptions="Center" />
                                </Border>

                                <!-- Score Input (For Teachers/Admins) -->
                                <Border Grid.Column="3"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource SurfaceLight}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        StrokeThickness="1"
                                        WidthRequest="68"
                                        HeightRequest="38"
                                        Padding="4,0"
                                        IsVisible="{Binding BindingContext.CanEditGrades, Source={x:Reference GradesRootPage}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.EditScoreCommand, Source={x:Reference GradesRootPage}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Entry Text="{Binding ScoreText}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding BindingContext.SaveSingleGradeCommand, Source={x:Reference GradesRootPage}}"
                                           ReturnCommandParameter="{Binding .}"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Read-Only Score Badge (For Students/Parents) -->
                                <Border Grid.Column="3"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        Stroke="{StaticResource PrimaryBorder}"
                                        StrokeThickness="1"
                                        Padding="10,6"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding BindingContext.IsReadOnlyGrades, Source={x:Reference GradesRootPage}}">
                                    <Label Text="{Binding ScoreObtained, StringFormat='{0:F0} / 100'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Interactive Action Button for Teacher: "Edit" when clean, "Save" when modified! -->
                                <Button Grid.Column="4"
                                        Text="{Binding SaveButtonText}"
                                        Command="{Binding BindingContext.HandleRowActionCommand, Source={x:Reference GradesRootPage}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{Binding SaveButtonBg}"
                                        TextColor="{Binding SaveButtonTextColor}"
                                        BorderColor="{StaticResource SurfaceBorder}"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        CornerRadius="6"
                                        IsVisible="{Binding BindingContext.CanEditGrades, Source={x:Reference GradesRootPage}}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- 3. Bottom Action Footer Bar (Always Visible to Teachers/Admins) -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource SurfaceCard}"
                Stroke="{StaticResource SurfaceBorder}"
                StrokeThickness="1"
                Padding="16,10"
                Margin="0,8,0,0"
                IsVisible="{Binding CanEditGrades}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding ActiveSubjectHeader, StringFormat='Subject: {0}'}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{Binding ClassSummary}"
                           FontSize="11"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Save All Grades"
                        Command="{Binding SaveGradesCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="42"
                        Padding="18,0"
                        CornerRadius="8"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
