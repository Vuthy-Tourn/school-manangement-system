<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.GradesPage"
             x:DataType="vm:GradesViewModel"
             Title="{Binding PortalTitle}"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,20">

        <!-- Assessment Filter Header Card -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource SurfaceCard}"
                Stroke="{StaticResource SurfaceBorder}"
                StrokeThickness="1"
                Padding="18,16"
                Margin="0,0,0,14">
            <VerticalStackLayout Spacing="12">

                <!-- Row 1: Exam and Class (Class picker hidden for students) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Exam Picker -->
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Academic Examination"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="10,0"
                                HeightRequest="42">
                            <Picker ItemsSource="{Binding Exams}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedExam}"
                                    SelectedIndexChanged="OnFilterChanged"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="12"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Class Picker (Visible only for faculty/admin) -->
                    <VerticalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding CanEditGrades}">
                        <Label Text="Class Section"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="10,0"
                                HeightRequest="42">
                            <Picker ItemsSource="{Binding Classes}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedClass}"
                                    SelectedIndexChanged="OnFilterChanged"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="12"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Student Info Badge (Shown when Class picker is hidden) -->
                    <VerticalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding IsReadOnlyGrades}">
                        <Label Text="Student Academic Record"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource PrimaryBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                Padding="10,0"
                                HeightRequest="42">
                            <Label Text="Enrolled Student"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Row 2: Assessment Component -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Assessment Component / Subject"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource SurfaceLight}"
                            Padding="10,0"
                            HeightRequest="42">
                        <Picker ItemsSource="{Binding Components}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedComponent}"
                                SelectedIndexChanged="OnComponentChanged"
                                TextColor="{StaticResource TextPrimary}"
                                FontSize="12"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- Student Grading List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadGradesCommand}">
            <CollectionView ItemsSource="{Binding StudentGrades}">
                <CollectionView.EmptyView>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,20"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_grades.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                            <Label Text="No Grading Component Selected"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="Select an exam and assessment component from the dropdowns above to view marks."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GradeEntryItemViewModel">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                <!-- Student Details -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding StudentName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding AdmissionNumber}"
                                           FontSize="11"
                                           TextColor="{StaticResource SecondaryDark}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <!-- Score Numeric Input (For Teachers/Admins) -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource SurfaceLight}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        StrokeThickness="1"
                                        WidthRequest="76"
                                        HeightRequest="38"
                                        Padding="6,0"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:GradesViewModel}}, Path=CanEditGrades}">
                                    <Entry Text="{Binding ScoreObtained}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Read-Only Score Badge (For Students/Parents) -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        Stroke="{StaticResource PrimaryBorder}"
                                        StrokeThickness="1"
                                        Padding="12,6"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:GradesViewModel}}, Path=IsReadOnlyGrades}">
                                    <Label Text="{Binding ScoreObtained, StringFormat='{0:F0} / 100'}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                </Border>

                                <!-- Report Card Link Button -->
                                <Button Grid.Column="2"
                                        Text="Report Card"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GradesViewModel}}, Path=ViewReportCardCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        CornerRadius="6" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Save Button Footer (Visible ONLY to Teachers and Administrators) -->
        <Border Grid.Row="2" BackgroundColor="Transparent" Padding="0,12,0,0"
                IsVisible="{Binding CanEditGrades}">
            <Button Text="Save Exam Grades"
                    Command="{Binding SaveGradesCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="8" />
        </Border>

    </Grid>

</ContentPage>
