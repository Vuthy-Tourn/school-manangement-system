<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource SurfaceLight}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <ScrollView>
        <Grid Padding="24,40,24,32" VerticalOptions="Center" MaximumWidthRequest="500">
            <VerticalStackLayout Spacing="24">

                <!-- Brand Header with Official Nexora Logo (Animated Entrance) -->
                <VerticalStackLayout x:Name="BrandHeaderSection"
                                     Spacing="6"
                                     HorizontalOptions="Center"
                                     Opacity="0"
                                     TranslationY="-24">
                    <Image Source="logo_full_transparent.png"
                           WidthRequest="220"
                           HeightRequest="180"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <!-- School Institution Pill -->
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Stroke="{StaticResource PrimaryBorder}"
                            StrokeThickness="1"
                            Padding="14,5"
                            HorizontalOptions="Center"
                            Margin="0,0,0,0">
                        <Label Text="Angkor International Academy"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Main Login Card (Animated Entrance) -->
                <Border x:Name="LoginCardSection"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource SurfaceCard}"
                        Stroke="{StaticResource SurfaceBorder}"
                        StrokeThickness="1"
                        Padding="28,24"
                        Opacity="0"
                        TranslationY="36"
                        Scale="0.96">
                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sign In to Your Account"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Enter your institutional credentials below"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <!-- Quick Role Demo Selector -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Quick Role Demo Switcher"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        Text="Admin"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="admin"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="1"
                                        Text="Teacher"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="teacher"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="2"
                                        Text="Student"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="student"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="3"
                                        Text="Parent"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="parent"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                            </Grid>

                            <!-- Active Role Indicator -->
                            <Label Text="{Binding SelectedRoleLabel, StringFormat='Active Profile: {0}'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryDark}" />
                        </VerticalStackLayout>

                        <!-- Username or Email Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Username or Email"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="14,2"
                                    HeightRequest="46">
                                <Entry Text="{Binding Username}"
                                       Placeholder="e.g. admin or teacher.dara"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="14,2"
                                    HeightRequest="46">
                                <Entry Text="{Binding Password}"
                                       IsPassword="True"
                                       Placeholder="Enter your secure password"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error Banner -->
                        <Border IsVisible="{Binding HasError}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource DangerLight}"
                                Stroke="{StaticResource DangerBorder}"
                                StrokeThickness="1"
                                Padding="14,10">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{StaticResource DangerText}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Sign In Button -->
                        <Button Text="Sign In to Nexora"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="8"
                                HeightRequest="48" />

                        <!-- Busy Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Secondary}"
                                           HorizontalOptions="Center"
                                           HeightRequest="32" WidthRequest="32" />

                    </VerticalStackLayout>
                </Border>

                <!-- Institutional Compliance Footer (Animated Entrance) -->
                <VerticalStackLayout x:Name="FooterSection"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     Opacity="0">
                    <Label Text="Nexora Cloud Education Architecture"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Strict Multi-Tenant Isolation • Role-Based Access Control • TLS 1.3"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
