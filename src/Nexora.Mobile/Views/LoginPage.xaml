<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource SurfaceLight}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <Grid>
        <ScrollView>
            <Grid Padding="24,40,24,32" VerticalOptions="Center" MaximumWidthRequest="500">
            <VerticalStackLayout Spacing="24">

                <!-- Brand Header with Official Nexora Logo (Animated Entrance) -->
                <VerticalStackLayout x:Name="BrandHeaderSection"
                                     Spacing="6"
                                     HorizontalOptions="Center"
                                     Opacity="0"
                                     TranslationY="-24">
                    <Image Source="logo_full_transparent.png"
                           WidthRequest="220"
                           HeightRequest="180"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <!-- School Institution Pill -->
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Stroke="{StaticResource PrimaryBorder}"
                            StrokeThickness="1"
                            Padding="14,5"
                            HorizontalOptions="Center"
                            Margin="0,0,0,0">
                        <Label Text="Angkor International Academy"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Main Login Card (Animated Entrance) -->
                <Border x:Name="LoginCardSection"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource SurfaceCard}"
                        Stroke="{StaticResource SurfaceBorder}"
                        StrokeThickness="1"
                        Padding="28,24"
                        Opacity="0"
                        TranslationY="36"
                        Scale="0.96">
                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sign In to Your Account"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Enter your institutional credentials below"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <!-- Quick Role Demo Selector -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Quick Role Demo Switcher"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        Text="Admin"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="admin"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="1"
                                        Text="Teacher"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="teacher"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="2"
                                        Text="Student"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="student"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                                <Button Grid.Column="3"
                                        Text="Parent"
                                        Command="{Binding QuickSelectRoleCommand}"
                                        CommandParameter="parent"
                                        HeightRequest="36" Padding="4,0"
                                        FontSize="11" FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        TextColor="{StaticResource Secondary}"
                                        BorderColor="{StaticResource SecondaryBorder}"
                                        BorderWidth="1" />
                            </Grid>

                            <!-- Active Role Indicator -->
                            <Label Text="{Binding SelectedRoleLabel, StringFormat='Active Profile: {0}'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryDark}" />
                        </VerticalStackLayout>

                        <!-- Username or Email Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Username or Email"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="14,2"
                                    HeightRequest="46">
                                <Entry Text="{Binding Username}"
                                       Placeholder="e.g. admin or teacher.dara"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="14,2"
                                    HeightRequest="46">
                                <Entry Text="{Binding Password}"
                                       IsPassword="True"
                                       Placeholder="Enter your secure password"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error Banner -->
                        <Border IsVisible="{Binding HasError}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource DangerLight}"
                                Stroke="{StaticResource DangerBorder}"
                                StrokeThickness="1"
                                Padding="14,10">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{StaticResource DangerText}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Sign In Button -->
                        <Button Text="{Binding SignInButtonText}"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="8"
                                HeightRequest="48" />

                    </VerticalStackLayout>
                </Border>

                <!-- Institutional Compliance Footer (Animated Entrance) -->
                <VerticalStackLayout x:Name="FooterSection"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     Opacity="0">
                    <Label Text="Nexora Cloud Education Architecture"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Strict Multi-Tenant Isolation • Role-Based Access Control • TLS 1.3"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

    <!-- Executive Authentication Loading Overlay -->
    <Grid IsVisible="{Binding IsBusy}"
          BackgroundColor="#B8060E1F"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          InputTransparent="False"
          IgnoreSafeArea="True">

        <Border StrokeShape="RoundRectangle 22"
                BackgroundColor="#0F2042"
                Stroke="{StaticResource Secondary}"
                StrokeThickness="1.5"
                Padding="28,26"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="290">
            <Border.Shadow>
                <Shadow Brush="#2563EB"
                        Offset="0,8"
                        Radius="20"
                        Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                
                <!-- Luminous Nexora Crest Badge -->
                <Grid HorizontalOptions="Center" WidthRequest="68" HeightRequest="68">
                    <!-- Outer Ambient Pulse Circle -->
                    <Border WidthRequest="68" HeightRequest="68"
                            StrokeShape="RoundRectangle 34"
                            BackgroundColor="#162E5C"
                            Stroke="#0EA5E9"
                            StrokeThickness="1.5"
                            Opacity="0.85" />

                    <!-- Emblem Icon -->
                    <Image Source="logo_icon_white.png"
                           WidthRequest="38"
                           HeightRequest="38"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Titles & Active Role -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Nexora Portal"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" />

                    <!-- Active Institutional Profile Badge -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#163866"
                            Stroke="{StaticResource SecondaryBorder}"
                            StrokeThickness="1"
                            Padding="12,4"
                            HorizontalOptions="Center">
                        <Label Text="{Binding SelectedRoleLabel}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#38BDF8"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Animated Sleek Progress Track -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill" WidthRequest="210">
                    <ProgressBar Progress="{Binding LoadingProgress}"
                                 ProgressColor="#38BDF8"
                                 BackgroundColor="#1E293B"
                                 HeightRequest="4" />

                    <!-- Dynamic Live Status -->
                    <Label Text="{Binding LoadingStatusText}"
                           FontSize="11.5"
                           TextColor="{StaticResource Gray300}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- TLS 1.3 Security Live Indicator -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="3.5" Color="{StaticResource Success}" VerticalOptions="Center" />
                    <Label Text="TLS 1.3 Encrypted Handshake"
                           FontSize="10"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>
</Grid>

</ContentPage>
