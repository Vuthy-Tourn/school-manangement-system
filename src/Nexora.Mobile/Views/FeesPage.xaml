<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.FeesPage"
             x:DataType="vm:FeesViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource SurfaceLight}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadInvoicesCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,20,20,36">

                <!-- 1. Executive Financial Summary Row (Visible only to School Admins) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding IsAdminView}">
                    <!-- Invoiced -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TOTAL INVOICED" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Summary.TotalInvoiced, StringFormat='${0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Semester 1" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Collected -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="COLLECTED" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Summary.TotalCollected, StringFormat='${0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                            <Label Text="Via ABA Pay" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Outstanding -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="OUTSTANDING" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Summary.TotalOutstanding, StringFormat='${0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                            <Label Text="Unpaid" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 2. Invoices Section Header -->
                <Label Text="Student Invoices &amp; Statements"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />

                <!-- 3. Invoices List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Invoices}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:InvoiceDto">
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceCard}"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    Padding="18,16">
                                <VerticalStackLayout Spacing="12">

                                    <!-- Top Row: Student Name, Invoice Number, Status Badge -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding StudentName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding InvoiceNumber}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource SecondaryDark}" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource WarningLight}"
                                                Stroke="{StaticResource WarningBorder}"
                                                StrokeThickness="1"
                                                Padding="10,3"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding Status}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource WarningText}" />
                                        </Border>
                                    </Grid>

                                    <!-- Amounts Breakdown Box -->
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource SurfaceLight}"
                                            Stroke="{StaticResource SurfaceBorderSubtle}"
                                            StrokeThickness="1"
                                            Padding="14,10">
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Total Due" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding TotalAmount, StringFormat='${0:N2}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Amount Paid" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding PaidAmount, StringFormat='${0:N2}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Success}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="Remaining" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding RemainingBalance, StringFormat='${0:N2}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Danger}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Action Row: Due Date and CTA Buttons -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <Label Text="{Binding DueDate, StringFormat='Due Date: {0:MMM dd, yyyy}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}"
                                               VerticalOptions="Center" />

                                        <!-- Admin Action: Record Payment -->
                                        <Button Grid.Column="1"
                                                Text="Record Payment"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeesViewModel}}, Path=RecordPaymentPromptCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="{StaticResource White}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="34"
                                                Padding="14,0"
                                                CornerRadius="6"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FeesViewModel}}, Path=CanRecordPayment}" />

                                        <!-- Student & Parent Action: View Statement / Invoice Details -->
                                        <Button Grid.Column="1"
                                                Text="View Invoice"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeesViewModel}}, Path=ViewInvoiceDetailsCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                TextColor="{StaticResource Secondary}"
                                                BorderColor="{StaticResource SecondaryBorder}"
                                                BorderWidth="1"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="34"
                                                Padding="14,0"
                                                CornerRadius="6"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FeesViewModel}}, Path=IsReadOnlyInvoice}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
