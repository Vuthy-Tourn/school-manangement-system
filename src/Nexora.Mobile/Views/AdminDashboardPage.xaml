<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource SurfaceLight}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadDashboardCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="20,24,20,36">

                <!-- 1. Executive Institution Header -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource Primary}"
                        Stroke="{StaticResource PrimaryDark}"
                        StrokeThickness="1"
                        Padding="24,20">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Angkor International Academy"
                                       TextColor="{StaticResource Accent}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Label Text="•" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Label Text="AIA-KHM"
                                       TextColor="{StaticResource Gray300}"
                                       FontSize="12" />
                            </HorizontalStackLayout>

                            <Label Text="School Administration Portal"
                                   TextColor="{StaticResource White}"
                                   FontSize="22"
                                   FontAttributes="Bold" />

                            <Label Text="Academic Year 2026-2027 • Semester 1 • Real-Time Metrics"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Operational Status Indicator -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="#163866"
                                Stroke="{StaticResource SecondaryBorder}"
                                StrokeThickness="1"
                                Padding="10,6"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success}" VerticalOptions="Center" />
                                <Label Text="Live Connected" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Operations Quick Launch Grid -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Operations Quick Launch"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Students -->
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="students" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_students.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Students" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Student Directory" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Teachers -->
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="teachers" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_faculty.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Teachers" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Faculty Directory" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Attendance -->
                        <Border Grid.Row="0" Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="attendance" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_attendance.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Attendance" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Daily Tracking" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Grades -->
                        <Border Grid.Row="0" Grid.Column="3"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="grades" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_grades.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Grades" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Exams &amp; Scores" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Fees -->
                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="fees" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_fees.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Tuition Fees" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Invoices &amp; Pay" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Timetable -->
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="timetables" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_timetable.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Timetable" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Class Schedule" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Announcements -->
                        <Border Grid.Row="1" Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="announcements" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_announcements.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Updates" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Campus Notices" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Profile / Settings -->
                        <Border Grid.Row="1" Grid.Column="3"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="profile" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Image Source="icon_profile.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Profile" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Admin Account" FontSize="8.5" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- 3. Key Operational Performance Indicators -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Academic Metrics"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Total Students -->
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="students" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="TOTAL STUDENTS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Image Grid.Column="1" Source="icon_students.png" WidthRequest="18" HeightRequest="18" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalStudents}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="Enrolled Active Students" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Faculty -->
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="teachers" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="FACULTY STAFF" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Image Grid.Column="1" Source="icon_faculty.png" WidthRequest="18" HeightRequest="18" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalTeachers}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="Teaching Faculty" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Classes -->
                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="ACTIVE SECTIONS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Image Grid.Column="1" Source="icon_classes.png" WidthRequest="18" HeightRequest="18" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalClasses}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                <Label Text="Grade 10 Classrooms" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Daily Attendance -->
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="DAILY ATTENDANCE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Image Grid.Column="1" Source="icon_check.png" WidthRequest="18" HeightRequest="18" />
                                </Grid>
                                <Label Text="{Binding Stats.TodayAttendancePercentage, StringFormat='{0:F1}%'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                                <Label Text="Attendance Recorded Today" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Financial Summary Card -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="16,14"
                            Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="TUITION COLLECTED" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Stats.TotalFeesCollected, StringFormat='${0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                                <Label Text="Verified Payments" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="OUTSTANDING INVOICES" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Stats.TotalFeesOutstanding, StringFormat='${0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                                <Label Text="Due This Semester" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 4. Institutional Analytics & Visual Graphs -->
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Institutional Analytics &amp; Trends"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Weekly Attendance &amp; Tuition Performance Graphs"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                Stroke="{StaticResource PrimaryBorder}"
                                Padding="8,4">
                            <Label Text="Live Analytics" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <!-- Graph 1: Weekly Attendance Trend Bar Chart -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="18,16">
                        <VerticalStackLayout Spacing="14">
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Weekly Attendance Trend"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Monday – Friday Campus Attendance Rate"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource SuccessLight}"
                                        Stroke="{StaticResource SuccessBorder}"
                                        Padding="8,4">
                                    <Label Text="{Binding WeeklyAverageAttendance, StringFormat='Avg: {0:F1}%'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource SuccessText}" />
                                </Border>
                            </Grid>

                            <!-- 5-Day Bar Visualizer -->
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8" HeightRequest="150" Margin="0,8,0,0">
                                <!-- Monday -->
                                <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center" VerticalOptions="End"
                                                     BindingContext="{Binding WeeklyAttendance[0]}">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding TrackColor}" Padding="4,1"
                                            IsVisible="{Binding PeakBadgeVisible}">
                                        <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center"
                                           IsVisible="{Binding NormalLabelVisible}" />
                                    <Border HeightRequest="100" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding TrackColor}" StrokeThickness="0" VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding BarColor}" StrokeThickness="0" VerticalOptions="End" />
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold" TextColor="{Binding DayTextColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Tuesday -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="End"
                                                     BindingContext="{Binding WeeklyAttendance[1]}">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding TrackColor}" Padding="4,1"
                                            IsVisible="{Binding PeakBadgeVisible}">
                                        <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center"
                                           IsVisible="{Binding NormalLabelVisible}" />
                                    <Border HeightRequest="100" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding TrackColor}" StrokeThickness="0" VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding BarColor}" StrokeThickness="0" VerticalOptions="End" />
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold" TextColor="{Binding DayTextColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Wednesday -->
                                <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center" VerticalOptions="End"
                                                     BindingContext="{Binding WeeklyAttendance[2]}">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding TrackColor}" Padding="4,1"
                                            IsVisible="{Binding PeakBadgeVisible}">
                                        <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center"
                                           IsVisible="{Binding NormalLabelVisible}" />
                                    <Border HeightRequest="100" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding TrackColor}" StrokeThickness="0" VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding BarColor}" StrokeThickness="0" VerticalOptions="End" />
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold" TextColor="{Binding DayTextColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Thursday -->
                                <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center" VerticalOptions="End"
                                                     BindingContext="{Binding WeeklyAttendance[3]}">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding TrackColor}" Padding="4,1"
                                            IsVisible="{Binding PeakBadgeVisible}">
                                        <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center"
                                           IsVisible="{Binding NormalLabelVisible}" />
                                    <Border HeightRequest="100" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding TrackColor}" StrokeThickness="0" VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding BarColor}" StrokeThickness="0" VerticalOptions="End" />
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold" TextColor="{Binding DayTextColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Friday -->
                                <VerticalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center" VerticalOptions="End"
                                                     BindingContext="{Binding WeeklyAttendance[4]}">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding TrackColor}" Padding="4,1"
                                            IsVisible="{Binding PeakBadgeVisible}">
                                        <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding FormattedPercentage}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeColor}" HorizontalOptions="Center"
                                           IsVisible="{Binding NormalLabelVisible}" />
                                    <Border HeightRequest="100" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding TrackColor}" StrokeThickness="0" VerticalOptions="End">
                                        <Border HeightRequest="{Binding BarHeight}" WidthRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding BarColor}" StrokeThickness="0" VerticalOptions="End" />
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold" TextColor="{Binding DayTextColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Graph 2: Tuition Revenue Progress Bar -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="18,16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tuition Realization Progress"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Collected vs Outstanding Ratio"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        Stroke="{StaticResource PrimaryBorder}"
                                        Padding="8,4">
                                    <Label Text="{Binding FeeCollectionPercentage, StringFormat='{0:F1}% Realized'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>

                            <!-- Segmented Progress Bar -->
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    HeightRequest="14"
                                    StrokeThickness="0"
                                    Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CollectedWidth}" />
                                        <ColumnDefinition Width="{Binding OutstandingWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Collected Segment -->
                                    <BoxView Grid.Column="0" Color="{StaticResource Success}" HorizontalOptions="Fill" />
                                    <!-- Remaining Segment -->
                                    <BoxView Grid.Column="1" Color="{StaticResource Warning}" HorizontalOptions="Fill" />
                                </Grid>
                            </Border>

                            <!-- Breakdown Legends -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource SuccessLight}"
                                        Stroke="{StaticResource SuccessBorder}"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success}" VerticalOptions="Center" />
                                            <Label Text="Collected" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Stats.TotalFeesCollected, StringFormat='${0:N2}'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource WarningLight}"
                                        Stroke="{StaticResource WarningBorder}"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Warning}" VerticalOptions="Center" />
                                            <Label Text="Outstanding" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WarningText}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Stats.TotalFeesOutstanding, StringFormat='${0:N2}'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WarningText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Graph 3: Academic Grade Spread Distribution -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="18,16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Academic Performance Distribution"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="School-wide Grade 10 Exam Outcomes"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Semester 1" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>

                            <!-- 4-tier Grade Distribution Bar -->
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    HeightRequest="12"
                                    StrokeThickness="0"
                                    Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding GradeAWidth}" />
                                        <ColumnDefinition Width="{Binding GradeBWidth}" />
                                        <ColumnDefinition Width="{Binding GradeCWidth}" />
                                        <ColumnDefinition Width="{Binding GradeDFWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <BoxView Grid.Column="0" Color="#15803D" HorizontalOptions="Fill" />
                                    <BoxView Grid.Column="1" Color="#2563EB" HorizontalOptions="Fill" />
                                    <BoxView Grid.Column="2" Color="#D97706" HorizontalOptions="Fill" IsVisible="{Binding HasGradeC}" />
                                    <BoxView Grid.Column="3" Color="#DC2626" HorizontalOptions="Fill" IsVisible="{Binding HasGradeDF}" />
                                </Grid>
                            </Border>

                            <!-- Grade Legend Pills -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding GradeALabel}" FontSize="10" FontAttributes="Bold" TextColor="#15803D" HorizontalOptions="Center" />
                                    <Label Text="Distinction" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding GradeBLabel}" FontSize="10" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="Center" />
                                    <Label Text="Merit" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding GradeCLabel}" FontSize="10" FontAttributes="Bold" TextColor="#D97706" HorizontalOptions="Center" />
                                    <Label Text="Passing" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding GradeDFLabel}" FontSize="10" FontAttributes="Bold" TextColor="#DC2626" HorizontalOptions="Center" />
                                    <Label Text="Review" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 5. Campus Announcements -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Campus Announcements"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Column="1"
                               Text="View All →"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="announcements" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentAnnouncements}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:AnnouncementDto">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        Padding="16,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />

                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource WarningLight}"
                                                    Stroke="{StaticResource WarningBorder}"
                                                    StrokeThickness="1"
                                                    Padding="8,2">
                                                <Label Text="{Binding Priority}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource WarningText}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Content}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="WordWrap" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Label Text="{Binding PublishedByName, StringFormat='By {0}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                            <Label Text="•" TextColor="{StaticResource TextMuted}" FontSize="11" />
                                            <Label Text="{Binding PublishedAtUtc, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 5. Live Audit Trail -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Live Institutional Audit Trail"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentAudits}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:AuditLogDto">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                Stroke="{StaticResource SecondaryBorder}"
                                                StrokeThickness="1"
                                                Padding="8,4">
                                            <Label Text="{Binding Action}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource SecondaryDark}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Details}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TimestampUtc, StringFormat='By {0} • {1:HH:mm:ss UTC}'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
