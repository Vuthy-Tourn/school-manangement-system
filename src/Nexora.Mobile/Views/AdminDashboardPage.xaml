<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource SurfaceLight}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadDashboardCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="20,24,20,36">

                <!-- 1. Executive Institution Header -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource Primary}"
                        Stroke="{StaticResource PrimaryDark}"
                        StrokeThickness="1"
                        Padding="24,20">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Angkor International Academy"
                                       TextColor="{StaticResource Accent}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Label Text="•" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Label Text="AIA-KHM"
                                       TextColor="{StaticResource Gray300}"
                                       FontSize="12" />
                            </HorizontalStackLayout>

                            <Label Text="School Administration Portal"
                                   TextColor="{StaticResource White}"
                                   FontSize="22"
                                   FontAttributes="Bold" />

                            <Label Text="Academic Year 2026-2027 • Semester 1 • Real-Time Metrics"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Operational Status Indicator -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="#163866"
                                Stroke="{StaticResource SecondaryBorder}"
                                StrokeThickness="1"
                                Padding="10,6"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success}" VerticalOptions="Center" />
                                <Label Text="Live Connected" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Operations Quick Launch Grid -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Operations Quick Launch"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Students -->
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="students" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="👥" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Students" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Directory &amp; Enrollment" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Attendance -->
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="attendance" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="📋" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Attendance" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Daily Tracking" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Grades -->
                        <Border Grid.Row="0" Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="grades" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="📊" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Grades" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Exams &amp; Scoring" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Fees -->
                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="fees" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="💳" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Tuition &amp; Fees" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Invoices &amp; ABA Pay" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Timetable -->
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="timetables" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🗓" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Timetable" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Weekly Schedule" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Announcements -->
                        <Border Grid.Row="1" Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="announcements" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="📢" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="Updates" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                <Label Text="Campus Notices" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- 3. Key Operational Performance Indicators -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Academic Metrics"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Total Students -->
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="TOTAL STUDENTS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="🎓" FontSize="14" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalStudents}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="Enrolled Active Students" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Faculty -->
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="FACULTY STAFF" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="👨‍🏫" FontSize="14" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalTeachers}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="Teaching Faculty" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Classes -->
                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="ACTIVE SECTIONS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="🏫" FontSize="14" />
                                </Grid>
                                <Label Text="{Binding Stats.TotalClasses}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                <Label Text="Grade 10 Classrooms" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Daily Attendance -->
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="DAILY ATTENDANCE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="✅" FontSize="14" />
                                </Grid>
                                <Label Text="{Binding Stats.TodayAttendancePercentage, StringFormat='{0:F1}%'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                                <Label Text="Attendance Recorded Today" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Financial Summary Card -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="16,14"
                            Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="TUITION COLLECTED" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Stats.TotalFeesCollected, StringFormat='${0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                                <Label Text="Verified Payments" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="OUTSTANDING INVOICES" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Stats.TotalFeesOutstanding, StringFormat='${0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                                <Label Text="Due This Semester" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 4. Campus Announcements -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Campus Announcements"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Column="1"
                               Text="View All →"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="announcements" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentAnnouncements}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:AnnouncementDto">
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        Padding="16,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />

                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource WarningLight}"
                                                    Stroke="{StaticResource WarningBorder}"
                                                    StrokeThickness="1"
                                                    Padding="8,2">
                                                <Label Text="{Binding Priority}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource WarningText}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Content}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="WordWrap" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Label Text="{Binding PublishedByName, StringFormat='By {0}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                            <Label Text="•" TextColor="{StaticResource TextMuted}" FontSize="11" />
                                            <Label Text="{Binding PublishedAtUtc, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 5. Live Audit Trail -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Live Institutional Audit Trail"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentAudits}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:AuditLogDto">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                Stroke="{StaticResource SecondaryBorder}"
                                                StrokeThickness="1"
                                                Padding="8,4">
                                            <Label Text="{Binding Action}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource SecondaryDark}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Details}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TimestampUtc, StringFormat='By {0} • {1:HH:mm:ss UTC}'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
