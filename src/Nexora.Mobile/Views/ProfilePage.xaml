<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile &amp; Settings"
             BackgroundColor="{StaticResource SurfaceLight}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,20,20,36" MaximumWidthRequest="600">

            <!-- 1. Executive User Profile Identity Card -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="24,20">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">

                    <!-- Profile Avatar Circle -->
                    <Border StrokeShape="RoundRectangle 36"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Stroke="{StaticResource PrimaryBorder}"
                            StrokeThickness="1"
                            HeightRequest="72" WidthRequest="72"
                            HorizontalOptions="Center">
                        <Image Source="icon_profile.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Identity Details -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding FullName}"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Email}"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />

                        <!-- Role Pill (Styled with human-readable label, never numeric) -->
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                Stroke="{StaticResource SecondaryBorder}"
                                StrokeThickness="1"
                                Padding="14,4"
                                HorizontalOptions="Center"
                                Margin="0,6,0,0">
                            <Label Text="{Binding RoleBadge}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryDark}" />
                        </Border>

                        <Label Text="{Binding RoleDepartment}"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               Margin="0,2,0,0" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- 2. Editable Personal Profile Information -->
            <Border StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,18">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="icon_profile.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Text="Edit Personal Profile"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Full Name Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding FullName}"
                                   Placeholder="Enter your full name"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Email}"
                                   Keyboard="Email"
                                   Placeholder="name@angkoracademy.edu.kh"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Phone Number Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Phone Number" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding PhoneNumber}"
                                   Keyboard="Telephone"
                                   Placeholder="+855 12 345 678"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Save Profile Changes Button -->
                    <Button Text="Save Profile Changes"
                            Command="{Binding SaveProfileCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="44"
                            CornerRadius="8"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Institutional Environment Card -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Institutional Environment"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- School Name -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <Label Text="Institution:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="{Binding SchoolName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Location -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <Label Text="Location:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="Phnom Penh, Kingdom of Cambodia" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Timezone -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <Label Text="Timezone:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="Asia/Phnom_Penh (UTC+07:00)" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Academic Term -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <Label Text="Academic Term:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="Semester 1 • Academic Year 2026-2027" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Institutional Operations & Governance (Admins only) -->
            <Border StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,18"
                    IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Institutional Operations &amp; Administration"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- Classes & Sections Directory -->
                    <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource SurfaceLight}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="classes" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Image Source="icon_classes.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Classes &amp; Sections Directory" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Manage grade sections, room allocations &amp; homeroom advisors" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="→" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Security & Audit Trail -->
                    <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource SurfaceLight}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="audit-logs" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Image Source="icon_check.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Security &amp; Audit Trail" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Monitor institutional security events, edits &amp; access logs" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="→" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Sign Out Action -->
            <Button Text="Sign Out of Nexora"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource DangerLight}"
                    TextColor="{StaticResource DangerText}"
                    BorderColor="{StaticResource DangerBorder}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="8"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
