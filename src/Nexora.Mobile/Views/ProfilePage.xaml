<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile &amp; Settings"
             BackgroundColor="{StaticResource SurfaceLight}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,20,20,36" MaximumWidthRequest="600">

            <!-- 1. Executive User Profile Card -->
            <Border StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="24,20">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">

                    <!-- Profile Avatar Circle -->
                    <Border StrokeShape="RoundRectangle 36"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Stroke="{StaticResource PrimaryBorder}"
                            StrokeThickness="1"
                            HeightRequest="72" WidthRequest="72"
                            HorizontalOptions="Center">
                        <Image Source="icon_profile.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Identity Details -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Profile.FullName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Profile.Email}"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />

                        <!-- Role Pill -->
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                Stroke="{StaticResource SecondaryBorder}"
                                StrokeThickness="1"
                                Padding="12,3"
                                HorizontalOptions="Center"
                                Margin="0,6,0,0">
                            <Label Text="{Binding Profile.Role, StringFormat='Role: {0}'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryDark}" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- 2. Institution Information Card -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Institutional Environment"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- School Name -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <Label Text="Institution:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="{Binding Profile.SchoolName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Location -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <Label Text="Location:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="Phnom Penh, Kingdom of Cambodia" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Timezone -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <Label Text="Timezone:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Label Grid.Column="1" Text="Asia/Phnom_Penh (UTC+07:00)" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Backend & Database Connectivity -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="API Server &amp; Database Connection"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                Stroke="{StaticResource SecondaryBorder}"
                                StrokeThickness="1"
                                Padding="8,2">
                            <Label Text="{Binding ConnectionStatus}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryDark}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Server Endpoint URL" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <Entry Text="{Binding ServerUrl}"
                                   Placeholder="http://localhost:5180/"
                                   PlaceholderColor="{StaticResource TextSubtle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Test Backend Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="40"
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. System Preferences Card -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Preferences &amp; System"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <!-- Language Switcher Row -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Interface Language" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding SelectedLanguage}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Switch"
                                Command="{Binding ToggleLanguageCommand}"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                TextColor="{StaticResource Secondary}"
                                BorderColor="{StaticResource SecondaryBorder}"
                                BorderWidth="1"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                Padding="14,0"
                                CornerRadius="6" />
                    </Grid>

                    <!-- Version & Status Row -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Application Build" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding AppVersion}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SuccessLight}"
                                Stroke="{StaticResource SuccessBorder}"
                                StrokeThickness="1"
                                Padding="10,3">
                            <Label Text="Production Ready" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Sign Out Action -->
            <Button Text="Sign Out of Nexora"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource DangerLight}"
                    TextColor="{StaticResource DangerText}"
                    BorderColor="{StaticResource DangerBorder}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="8"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
