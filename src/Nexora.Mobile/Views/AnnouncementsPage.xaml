<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.AnnouncementsPage"
             x:DataType="vm:AnnouncementsViewModel"
             Title="Campus Announcements"
             BackgroundColor="{StaticResource SurfaceLight}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAnnouncementsCommand}">
        <CollectionView ItemsSource="{Binding Announcements}" Margin="20,16,20,24">
            <CollectionView.EmptyView>
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource SurfaceCard}"
                        Stroke="{StaticResource SurfaceBorder}"
                        Padding="32"
                        Margin="0,20"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📢" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No Active Announcements"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="All campus bulletins and official school notices will appear here."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:AnnouncementDto">
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            StrokeThickness="1"
                            Padding="18,16"
                            Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="10">
                            <!-- Header Row: Title & Priority Pill -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Title}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource WarningLight}"
                                        Stroke="{StaticResource WarningBorder}"
                                        StrokeThickness="1"
                                        Padding="10,2"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding Priority}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource WarningText}" />
                                </Border>
                            </Grid>

                            <!-- Announcement Body -->
                            <Label Text="{Binding Content}"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap"
                                   LineHeight="1.2" />

                            <!-- Footer Row: Author & Date -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="✍️" FontSize="12" VerticalOptions="Center" />
                                    <Label Text="{Binding PublishedByName, StringFormat='Published by {0}'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding PublishedAtUtc, StringFormat='{0:MMM dd, yyyy}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
