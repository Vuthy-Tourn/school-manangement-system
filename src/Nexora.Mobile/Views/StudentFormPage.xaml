<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.StudentFormPage"
             x:DataType="vm:StudentFormViewModel"
             Title="Register Student"
             BackgroundColor="{StaticResource SurfaceLight}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,20,16,32">

            <!-- Personal Details Card -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Student Identification" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                    <Label Text="Admission Number" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                        <Entry Text="{Binding AdmissionNumber}" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="First Name *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding FirstName}" Placeholder="e.g. Visal" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Last Name *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding LastName}" Placeholder="e.g. Chan" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Gender" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding Gender}" Placeholder="Male / Female" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Blood Group" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding BloodGroup}" Placeholder="e.g. O+, A+" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Date of Birth" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,4">
                        <DatePicker Date="{Binding DateOfBirth}" Format="yyyy-MM-dd" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Contact & Emergency Card -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Contact &amp; Emergency Details" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                    <Label Text="Phone Number" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                        <Entry Text="{Binding PhoneNumber}" Placeholder="+855 12 345 678" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                    </Border>

                    <Label Text="Email Address" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                        <Entry Text="{Binding Email}" Placeholder="student@school.edu.kh" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                    </Border>

                    <Label Text="Residential Address" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                        <Entry Text="{Binding Address}" Placeholder="Street, Khan, Phnom Penh" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Emergency Contact" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding EmergencyContactName}" Placeholder="Contact Name" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Emergency Phone" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceLight}" Stroke="{StaticResource SurfaceBorder}" Padding="10,2">
                                <Entry Text="{Binding EmergencyContactPhone}" Placeholder="Phone Number" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}" Padding="12,8">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
            </Border>

            <!-- Submit Button -->
            <Button Text="Save Student Record"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
