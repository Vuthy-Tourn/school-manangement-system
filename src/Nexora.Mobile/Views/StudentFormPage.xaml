<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             x:Class="Nexora.Mobile.Views.StudentFormPage"
             x:DataType="vm:StudentFormViewModel"
             Title="Register Student"
             BackgroundColor="{StaticResource SurfaceLight}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,20,20,36" MaximumWidthRequest="650">

            <!-- Form Introduction Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="New Student Registration"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="Fill in the required information to create an institutional student record."
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource DangerLight}"
                    Stroke="{StaticResource DangerBorder}"
                    StrokeThickness="1"
                    Padding="14,10">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource DangerText}"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Card 1: Academic & Institutional Identification -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,18">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="icon_attendance.png" WidthRequest="18" HeightRequest="18" />
                        <Label Text="Academic Identification"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </HorizontalStackLayout>

                    <!-- Admission Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Admission Number *"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <Entry Text="{Binding AdmissionNumber}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Card 2: Personal Profile Details -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,18">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="icon_profile.png" WidthRequest="18" HeightRequest="18" />
                        <Label Text="Personal Profile"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </HorizontalStackLayout>

                    <!-- Name Row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- First Name -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="First Name *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding FirstName}"
                                       Placeholder="e.g. Visal"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Last Name -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Last Name *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding LastName}"
                                       Placeholder="e.g. Chan"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Gender & Blood Group -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Gender -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Gender *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding Gender}"
                                       Placeholder="Male / Female"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Blood Group -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Blood Group"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding BloodGroup}"
                                       Placeholder="e.g. O+, A+, B+"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Date of Birth -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Date of Birth *"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <DatePicker Date="{Binding DateOfBirth}"
                                        Format="yyyy-MM-dd"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Card 3: Contact & Emergency Information -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Stroke="{StaticResource SurfaceBorder}"
                    StrokeThickness="1"
                    Padding="20,18">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="icon_phone.png" WidthRequest="18" HeightRequest="18" />
                        <Label Text="Contact &amp; Emergency Details"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </HorizontalStackLayout>

                    <!-- Phone Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Phone Number"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <Entry Text="{Binding PhoneNumber}"
                                   Placeholder="+855 12 345 678"
                                   PlaceholderColor="{StaticResource TextSubtle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <Entry Text="{Binding Email}"
                                   Placeholder="student@angkoracademy.edu.kh"
                                   PlaceholderColor="{StaticResource TextSubtle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Address -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Residential Address"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                Padding="12,2"
                                HeightRequest="44">
                            <Entry Text="{Binding Address}"
                                   Placeholder="Preah Sihanouk Blvd, Phnom Penh"
                                   PlaceholderColor="{StaticResource TextSubtle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Emergency Contact Name & Phone -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Emergency Contact"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding EmergencyContactName}"
                                       Placeholder="Guardian Name"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Emergency Phone"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource SurfaceBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SurfaceLight}"
                                    Padding="12,2"
                                    HeightRequest="44">
                                <Entry Text="{Binding EmergencyContactPhone}"
                                       Placeholder="+855 92 112 233"
                                       PlaceholderColor="{StaticResource TextSubtle}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Submission Actions -->
            <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                <Button Text="Save Student Record"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="8"
                        HeightRequest="48" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Secondary}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
