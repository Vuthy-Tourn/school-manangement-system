<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.StudentsPage"
             x:DataType="vm:StudentsViewModel"
             Title="Student Directory"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">

        <!-- Search Bar and Action Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <!-- Search Box (No background wrapper) -->
                <SearchBar Grid.Column="0"
                           Text="{Binding SearchTerm}"
                           Placeholder="Search by student name or admission number..."
                           PlaceholderColor="{StaticResource TextSubtle}"
                           TextColor="{StaticResource TextPrimary}"
                           SearchCommand="{Binding LoadStudentsCommand}"
                           BackgroundColor="Transparent"
                           FontSize="13"
                           HeightRequest="44"
                           VerticalOptions="Center" />

                <!-- Add Student Button -->
                <Button Grid.Column="1"
                        Text="+ Register Student"
                        Clicked="OnAddStudentClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="44"
                        Padding="16,0" />
            </Grid>
        </VerticalStackLayout>

        <!-- Students Collection View -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadStudentsCommand}">
            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.EmptyView>
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource SurfaceBorder}"
                            Padding="32"
                            Margin="0,20"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="icon_students.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                            <Label Text="No Students Found"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="No student records match your query. Click '+ Register Student' to enroll a new student."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="320" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:StudentDto">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceCard}"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentsViewModel}}, Path=EditStudentCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">

                                <!-- Initials Avatar -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource SecondaryLight}"
                                        Stroke="{StaticResource SecondaryBorder}"
                                        StrokeThickness="1"
                                        HeightRequest="44" WidthRequest="44"
                                        VerticalOptions="Center">
                                    <Image Source="icon_students.png"
                                           WidthRequest="22" HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Student Information -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding FullName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />

                                        <!-- Class Badge -->
                                        <Border StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Stroke="{StaticResource PrimaryBorder}"
                                                StrokeThickness="1"
                                                Padding="6,1"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding CurrentClassName, StringFormat='Class {0}'}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Identification and Details -->
                                    <Label LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           FontSize="11">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AdmissionNumber}" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" />
                                                <Span Text=" • " TextColor="{StaticResource TextSubtle}" />
                                                <Span Text="{Binding Gender}" TextColor="{StaticResource TextSecondary}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Status Badge and Actions -->
                                <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource SuccessLight}"
                                            Stroke="{StaticResource SuccessBorder}"
                                            StrokeThickness="1"
                                            Padding="10,3"
                                            HorizontalOptions="End">
                                        <Label Text="{Binding Status}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SuccessText}" />
                                    </Border>

                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="Edit"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentsViewModel}}, Path=EditStudentCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                TextColor="{StaticResource SecondaryDark}"
                                                BorderColor="{StaticResource SecondaryBorder}"
                                                BorderWidth="1"
                                                CornerRadius="6"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                HeightRequest="28"
                                                Padding="8,0" />

                                        <Button Text="Deactivate"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentsViewModel}}, Path=DeactivateStudentCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource DangerLight}"
                                                TextColor="{StaticResource DangerText}"
                                                BorderColor="{StaticResource DangerBorder}"
                                                BorderWidth="1"
                                                CornerRadius="6"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                HeightRequest="28"
                                                Padding="8,0" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
