<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexora.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Nexora.Application.DTOs;assembly=Nexora.Application"
             x:Class="Nexora.Mobile.Views.ClassesPage"
             x:Name="ClassesRootPage"
             x:DataType="vm:ClassesViewModel"
             Title="Classes &amp; Subjects"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,20">

        <!-- Top Segment Switcher -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource SurfaceCard}"
                Stroke="{StaticResource SurfaceBorder}"
                StrokeThickness="1"
                Padding="4"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Text="Classrooms &amp; Sections"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"
                        BackgroundColor="{Binding SelectedTabColor0}"
                        TextColor="{Binding SelectedTextColor0}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />

                <Button Grid.Column="1"
                        Text="Curriculum Subjects"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"
                        BackgroundColor="{Binding SelectedTabColor1}"
                        TextColor="{Binding SelectedTextColor1}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="8"
                        HeightRequest="38" />
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{StaticResource SurfaceBorder}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource SurfaceCard}"
                Padding="8,0"
                Margin="0,0,0,16"
                HeightRequest="44">
            <SearchBar Text="{Binding SearchTerm}"
                       Placeholder="Search classes, rooms, teachers or subjects..."
                       PlaceholderColor="{StaticResource TextSubtle}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       FontSize="13"
                       VerticalOptions="Center" />
        </Border>

        <!-- Content Area: Refreshable CollectionView -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadDataCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <!-- Tab 1: Classrooms & Sections -->
                    <VerticalStackLayout IsVisible="{Binding IsClassesTab}" Spacing="12">
                        <Label Text="Academic Class Sections"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <CollectionView ItemsSource="{Binding FilteredClasses}">
                            <CollectionView.EmptyView>
                                <Border StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource SurfaceCard}"
                                        Stroke="{StaticResource SurfaceBorder}"
                                        Padding="30"
                                        Margin="0,10"
                                        HorizontalOptions="Center">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Image Source="icon_classes.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                                        <Label Text="No Class Sections Found"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ClassSectionDto">
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource SurfaceCard}"
                                            Stroke="{StaticResource SurfaceBorder}"
                                            StrokeThickness="1"
                                            Padding="18,16"
                                            Margin="0,0,0,12">
                                        <VerticalStackLayout Spacing="12">

                                            <!-- Header: Class Name, Badges -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        BackgroundColor="{StaticResource PrimaryLight}"
                                                        Stroke="{StaticResource PrimaryBorder}"
                                                        HeightRequest="42" WidthRequest="42"
                                                        VerticalOptions="Center">
                                                    <Image Source="icon_classes.png"
                                                           WidthRequest="22" HeightRequest="22"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Label Text="{Binding Name, StringFormat='Class {0}'}"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}" />

                                                        <Border StrokeShape="RoundRectangle 6"
                                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                                Stroke="{StaticResource SecondaryBorder}"
                                                                Padding="6,1"
                                                                VerticalOptions="Center">
                                                            <Label Text="{Binding GradeLevelName}"
                                                                   FontSize="10"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource SecondaryDark}" />
                                                        </Border>
                                                    </HorizontalStackLayout>

                                                    <Label Text="{Binding AcademicYearName, StringFormat='Academic Session: {0}'}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TextSecondary}" />
                                                </VerticalStackLayout>

                                                <!-- Room Badge -->
                                                <Border Grid.Column="2"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{StaticResource SurfaceLight}"
                                                        Stroke="{StaticResource SurfaceBorder}"
                                                        Padding="8,3"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding RoomNumber, TargetNullValue='Room TBA'}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextSecondary}" />
                                                </Border>
                                            </Grid>

                                            <!-- Capacity & Enrollment Progress -->
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="Enrollment Capacity" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding EnrolledCount, StringFormat='{0}/40 Students'}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                </Grid>
                                                <ProgressBar Progress="0.7"
                                                             ProgressColor="{StaticResource Secondary}"
                                                             BackgroundColor="{StaticResource SurfaceLight}"
                                                             HeightRequest="6" />
                                            </VerticalStackLayout>

                                            <!-- Homeroom Advisor & Action Bar -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                    <Image Source="icon_faculty.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                                    <Label Text="{Binding ClassTeacherName, TargetNullValue='Homeroom Advisor: Mr. Dara Sok', StringFormat='Advisor: {0}'}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                                    <!-- Admin Only: Assign Homeroom Advisor -->
                                                    <Button Text="Assign Advisor"
                                                            Command="{Binding BindingContext.AssignAdvisorCommand, Source={x:Reference ClassesRootPage}}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding BindingContext.IsAdmin, Source={x:Reference ClassesRootPage}}"
                                                            BackgroundColor="{StaticResource SecondaryLight}"
                                                            TextColor="{StaticResource SecondaryDark}"
                                                            BorderColor="{StaticResource SecondaryBorder}"
                                                            BorderWidth="1"
                                                            CornerRadius="6"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            HeightRequest="28"
                                                            Padding="10,0" />

                                                    <!-- Teacher Shortcut: Take Attendance -->
                                                    <Button Text="Take Attendance"
                                                            Command="{Binding BindingContext.TakeClassAttendanceCommand, Source={x:Reference ClassesRootPage}}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding BindingContext.IsTeacher, Source={x:Reference ClassesRootPage}}"
                                                            BackgroundColor="{StaticResource Secondary}"
                                                            TextColor="{StaticResource White}"
                                                            CornerRadius="6"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            HeightRequest="28"
                                                            Padding="10,0" />

                                                    <Button Text="View Roster"
                                                            Command="{Binding BindingContext.ViewRosterCommand, Source={x:Reference ClassesRootPage}}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{StaticResource PrimaryLight}"
                                                            TextColor="{StaticResource Primary}"
                                                            BorderColor="{StaticResource PrimaryBorder}"
                                                            BorderWidth="1"
                                                            CornerRadius="6"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            HeightRequest="28"
                                                            Padding="10,0" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Tab 2: Curriculum Subjects -->
                    <VerticalStackLayout IsVisible="{Binding IsSubjectsTab}" Spacing="12">
                        <Label Text="Institutional Curriculum Subjects"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <CollectionView ItemsSource="{Binding FilteredSubjects}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:SubjectDto">
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource SurfaceCard}"
                                            Stroke="{StaticResource SurfaceBorder}"
                                            StrokeThickness="1"
                                            Padding="16,14"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{StaticResource SecondaryLight}"
                                                    Stroke="{StaticResource SecondaryBorder}"
                                                    Padding="8,6"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Code}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource SecondaryDark}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding Description, TargetNullValue='Core secondary academic discipline'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{StaticResource SurfaceLight}"
                                                    Stroke="{StaticResource SurfaceBorder}"
                                                    Padding="8,3"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding CreditHours, StringFormat='{0} Credits'}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
