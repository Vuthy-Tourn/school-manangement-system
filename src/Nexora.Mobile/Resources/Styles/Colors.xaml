<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================================================= -->
    <!-- NEXORA BRAND PALETTE: Executive Deep Navy, Modern Blue & Slate   -->
    <!-- ================================================================= -->

    <!-- Primary Brand: Deep Navy (Intelligent, trustworthy, institutional) -->
    <Color x:Key="Primary">#0F2042</Color>
    <Color x:Key="PrimaryDark">#09142A</Color>
    <Color x:Key="PrimaryHover">#162E5C</Color>
    <Color x:Key="PrimaryLight">#EEF4FB</Color>
    <Color x:Key="PrimaryBorder">#D2E3F7</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- Secondary Brand: Modern Sapphire Blue (Active, energetic, interactive) -->
    <Color x:Key="Secondary">#2563EB</Color>
    <Color x:Key="SecondaryDark">#1D4ED8</Color>
    <Color x:Key="SecondaryHover">#3B82F6</Color>
    <Color x:Key="SecondaryLight">#EFF6FF</Color>
    <Color x:Key="SecondaryBorder">#BFDBFE</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>

    <!-- Accent: Crisp Cyan / Teal (Highlights, charts, and metrics) -->
    <Color x:Key="Accent">#0EA5E9</Color>
    <Color x:Key="AccentLight">#F0F9FF</Color>
    <Color x:Key="AccentBorder">#BAE6FD</Color>
    <Color x:Key="Tertiary">#6366F1</Color>

    <!-- Semantic Status: Success (Emerald) -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessLight">#ECFDF5</Color>
    <Color x:Key="SuccessBorder">#A7F3D0</Color>
    <Color x:Key="SuccessText">#065F46</Color>

    <!-- Semantic Status: Warning (Amber) -->
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningLight">#FFFBEB</Color>
    <Color x:Key="WarningBorder">#FDE68A</Color>
    <Color x:Key="WarningText">#92400E</Color>

    <!-- Semantic Status: Danger (Crimson Red) -->
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerLight">#FEF2F2</Color>
    <Color x:Key="DangerBorder">#FECACA</Color>
    <Color x:Key="DangerText">#991B1B</Color>

    <!-- Semantic Status: Info (Cobalt Blue) -->
    <Color x:Key="Info">#2563EB</Color>
    <Color x:Key="InfoLight">#EFF6FF</Color>
    <Color x:Key="InfoBorder">#BFDBFE</Color>
    <Color x:Key="InfoText">#1E40AF</Color>

    <!-- Surfaces & Neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0F172A</Color>
    <Color x:Key="SurfaceLight">#F8FAFC</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceBorder">#E2E8F0</Color>
    <Color x:Key="SurfaceBorderSubtle">#F1F5F9</Color>
    <Color x:Key="SurfaceHover">#F8FAFC</Color>

    <!-- High-Level Background Compatibility -->
    <Color x:Key="MidnightBlue">#0F2042</Color>
    <Color x:Key="OffBlack">#0F172A</Color>
    <Color x:Key="Magenta">#2563EB</Color>

    <!-- Text Hierarchy -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TextSubtle">#94A3B8</Color>
    <Color x:Key="TextWhite">#FFFFFF</Color>

    <!-- Slate Grayscale Scale -->
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLight}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLight}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLight}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorder}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>