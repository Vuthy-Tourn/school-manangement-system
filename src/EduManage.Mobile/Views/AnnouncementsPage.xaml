<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduManage.Mobile.ViewModels"
             xmlns:dto="clr-namespace:EduManage.Application.DTOs;assembly=EduManage.Application"
             x:Class="EduManage.Mobile.Views.AnnouncementsPage"
             x:DataType="vm:AnnouncementsViewModel"
             Title="Announcements"
             BackgroundColor="{StaticResource SurfaceLight}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAnnouncementsCommand}">
        <CollectionView ItemsSource="{Binding Announcements}" Margin="16">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                    <Label Text="📢" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="No Active Announcements" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:AnnouncementDto">
                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource WarningLight}" Padding="6,2" StrokeThickness="0">
                                    <Label Text="{Binding Priority}" FontSize="10" TextColor="{StaticResource Warning}" FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding Content}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Label Text="{Binding PublishedByName, StringFormat='By {0}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Column="1" Text="{Binding PublishedAtUtc, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
