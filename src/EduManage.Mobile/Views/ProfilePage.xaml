<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduManage.Mobile.ViewModels"
             x:Class="EduManage.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile &amp; Settings"
             BackgroundColor="{StaticResource SurfaceLight}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,20,16,32">

            <!-- Profile Info Card -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="20">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    
                    <Border StrokeShape="RoundRectangle 36"
                            BackgroundColor="{StaticResource Primary}"
                            HeightRequest="72" WidthRequest="72"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Label Text="👤" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Profile.FullName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Profile.Email}" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource PrimaryLight}" Padding="10,4" StrokeThickness="0" HorizontalOptions="Center" Margin="0,6,0,0">
                            <Label Text="{Binding Profile.Role, StringFormat='Role: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Institution Information Card -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Institution Details" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="School:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="{Binding Profile.SchoolName}" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Location:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="Phnom Penh, Cambodia" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Timezone:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="Asia/Phnom_Penh (UTC+7)" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Settings Card -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Preferences" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Language" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding SelectedLanguage}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Switch"
                                Command="{Binding ToggleLanguageCommand}"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="{StaticResource Primary}"
                                FontSize="11" FontAttributes="Bold"
                                HeightRequest="36" Padding="12,0" CornerRadius="8" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Application Build" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding AppVersion}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Production Ready" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sign Out Button -->
            <Button Text="Sign Out"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource DangerLight}"
                    TextColor="{StaticResource Danger}"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
