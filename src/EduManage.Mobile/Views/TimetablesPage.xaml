<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduManage.Mobile.ViewModels"
             xmlns:dto="clr-namespace:EduManage.Application.DTOs;assembly=EduManage.Application"
             x:Class="EduManage.Mobile.Views.TimetablesPage"
             x:DataType="vm:TimetablesViewModel"
             Title="Class Timetable"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid RowDefinitions="Auto,*" Padding="16,16,16,20">

        <!-- Day Selector Chips Bar -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,14">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Monday" Command="{Binding SelectDayCommand}" CommandParameter="Monday" CornerRadius="8" HeightRequest="36" Padding="12,0" FontSize="12" BackgroundColor="{StaticResource PrimaryLight}" TextColor="{StaticResource Primary}" />
                <Button Text="Tuesday" Command="{Binding SelectDayCommand}" CommandParameter="Tuesday" CornerRadius="8" HeightRequest="36" Padding="12,0" FontSize="12" BackgroundColor="{StaticResource PrimaryLight}" TextColor="{StaticResource Primary}" />
                <Button Text="Wednesday" Command="{Binding SelectDayCommand}" CommandParameter="Wednesday" CornerRadius="8" HeightRequest="36" Padding="12,0" FontSize="12" BackgroundColor="{StaticResource PrimaryLight}" TextColor="{StaticResource Primary}" />
                <Button Text="Thursday" Command="{Binding SelectDayCommand}" CommandParameter="Thursday" CornerRadius="8" HeightRequest="36" Padding="12,0" FontSize="12" BackgroundColor="{StaticResource PrimaryLight}" TextColor="{StaticResource Primary}" />
                <Button Text="Friday" Command="{Binding SelectDayCommand}" CommandParameter="Friday" CornerRadius="8" HeightRequest="36" Padding="12,0" FontSize="12" BackgroundColor="{StaticResource PrimaryLight}" TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Time Slots List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTimetableCommand}">
            <CollectionView ItemsSource="{Binding ScheduleSlots}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                        <Label Text="🗓" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No Classes Scheduled" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        <Label Text="No scheduled academic slots for this day." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TimetableEntryDto">
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource SurfaceBorder}" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">

                                <!-- Time Slot Badge -->
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource PrimaryLight}" Padding="10,8" StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                        <Label Text="to" FontSize="9" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                                        <Label Text="{Binding EndTime, StringFormat='{0:hh\\:mm}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Class & Teacher Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding SubjectName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding SubjectCode}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                    <Label Text="{Binding TeacherName, StringFormat='Teacher: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding RoomNumber, StringFormat='Room: {0}'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
