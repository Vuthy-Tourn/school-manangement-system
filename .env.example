# Nexora School Management System - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

# Database Settings
POSTGRES_DB=nexora_school_db
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=nexora_secure_password_2026!
# Using 5433 for external port to avoid conflict if host machine already runs local PostgreSQL on 5432
POSTGRES_PORT=5433

# API Server Settings
API_PORT=5180
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication
# In production, use a strong 256-bit+ random secret
JWT_SECRET=NexoraSchoolManagement_SuperSecret_JwtKey_2026_Cambodia_EdTech!
JWT_ISSUER=NexoraServer
JWT_AUDIENCE=NexoraClients
JWT_EXPIRY_MINUTES=120
JWT_REFRESH_EXPIRY_DAYS=7

# Default School Settings (for initial setup)
DEFAULT_SCHOOL_NAME="Angkor International Academy"
DEFAULT_TIMEZONE="Asia/Phnom_Penh"
DEFAULT_CURRENCY="USD"
